# ============================================================
# Standard El-Joumla - Production Environment Template
# ============================================================
# ⚠️  انسخ هذا الملف إلى .env.production وعدّل القيم
# ⚠️  لا ترتكب .env.production أبداً في Git!
#
# cp .env.production.template .env.production
# ============================================================

# ── API Configuration ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False

# ── JWT Configuration ─────────────────────────────────────
# ⚠️ غيّر هذا إلى مفتاح عشوائي طويل (64+ حرف)
JWT_SECRET_KEY=CHANGE_ME_generate_with:python-c-secretstoken_hex(64)
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=2
JWT_REFRESH_EXPIRY_DAYS=7

# ── Database Configuration ─────────────────────────────────
DB_TYPE=sqlite
DATABASE_PATH=data/erp_system.db
DATABASE_POOL_SIZE=20

# PostgreSQL (if DB_TYPE=postgres)
# DATABASE_URL=postgresql://erp_user:SECURE_PASSWORD@db-host:5432/erp_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=erp_db
# DB_USER=erp_user
# DB_PASSWORD=CHANGE_ME

# ── Redis Configuration ────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=CHANGE_ME
CACHE_USE_REDIS=1

# ── Security ───────────────────────────────────────────────
ENABLE_2FA=True
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT_MINUTES=30
ENCRYPTION_KEY=CHANGE_ME_generate_with:python-c-secretstoken_hex(32)

# ── CORS ───────────────────────────────────────────────────
CORS_ENABLED=True
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=WARNING
LOG_FILE=/app/logs/erp.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ── Backup ─────────────────────────────────────────────────
BACKUP_PATH=data/backups
AUTO_BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# ── Monitoring (Optional) ─────────────────────────────────
# SENTRY_DSN=your-sentry-dsn-here
# PROMETHEUS_METRICS_ENABLED=True
{
  "dashboard": {
    "id": null,
    "title": "Unified Commerce ERP - AI Performance",
    "tags": ["erp", "ai", "ml"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "AI Model Accuracy",
        "type": "stat",
        "targets": [
          {
            "expr": "ai_model_accuracy",
            "legendFormat": "{{model_name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "AI Prediction Response Time",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(ai_prediction_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Chatbot Interactions",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(chatbot_interactions_total[1h])",
            "legendFormat": "Interactions per hour"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "Predictive Analytics Usage",
        "type": "stat",
        "targets": [
          {
            "expr": "predictive_analytics_requests_total",
            "legendFormat": "Total Requests"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "AI Model Training Status",
        "type": "table",
        "targets": [
          {
            "expr": "ai_model_training_status",
            "legendFormat": "{{model_name}}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 16
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    },
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 0,
    "links": []
  }
}
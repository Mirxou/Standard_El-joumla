# Unified Commerce ERP Production Environment Variables
# Version: 1.0.0
# Description: Production environment configuration

# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production
DJANGO_SETTINGS_MODULE=config.production
ALLOWED_HOSTS=localhost,127.0.0.1,unifiedcommerce2030.com,www.unifiedcommerce2030.com

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=unified_commerce_prod
DB_USER=erp_user
DB_PASSWORD=your-secure-db-password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=require

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=your-redis-password
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@unifiedcommerce2030.com

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
X_FRAME_OPTIONS=DENY

# File Upload Settings
FILE_UPLOAD_MAX_MEMORY_SIZE=26214400  # 25MB
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400  # 25MB
FILE_UPLOAD_TEMP_DIR=/tmp

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/erp.log

# AI Service Configuration
AI_SERVICE_URL=http://ai-service:8002
AI_MODEL_PATH=/app/models
AI_CACHE_DIR=/app/cache/ai

# Monitoring Configuration
PROMETHEUS_METRICS_ENABLED=True
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=production

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/unifiedcommerce2030.com.crt
SSL_KEY_PATH=/etc/ssl/private/unifiedcommerce2030.com.key
SSL_DH_PARAM_PATH=/etc/ssl/dhparam.pem

# Nginx Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_CLIENT_MAX_BODY_SIZE=50M

# Performance Settings
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# API Configuration
API_THROTTLE_ANON=100/hour
API_THROTTLE_USER=1000/hour
API_THROTTLE_STAFF=10000/hour

# Third-party Services
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-key
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Social Authentication
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
MIXPANEL_TOKEN=your-mixpanel-token

# CDN Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=unified-commerce-prod
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=cdn.unifiedcommerce2030.com

# Localization
LANGUAGE_CODE=ar
TIME_ZONE=Asia/Riyadh
USE_I18N=True
USE_L10N=True
USE_TZ=True

# Admin Configuration
ADMIN_URL=admin/
ADMIN_EMAIL=admin@unifiedcommerce2030.com

# Maintenance Mode
MAINTENANCE_MODE=False
MAINTENANCE_MESSAGE=The system is currently under maintenance. Please try again later.

# Feature Flags
ENABLE_AI_FEATURES=True
ENABLE_ANALYTICS=True
ENABLE_BACKUP=True
ENABLE_CACHE=True
ENABLE_CDN=True
ENABLE_EMAIL=True
ENABLE_NOTIFICATIONS=True
ENABLE_REPORTING=True
ENABLE_SCHEDULER=True
ENABLE_SEARCH=True
ENABLE_SOCIAL_AUTH=True
ENABLE_WEBHOOKS=True

# Grafana Configuration
GRAFANA_PASSWORD=admin123
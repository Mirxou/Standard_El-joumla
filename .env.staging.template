# ============================================================================
# Standard El-Joumla ERP — Staging Environment Configuration
# Copy to .env.staging and fill in the values
# ============================================================================

# ── Application ───────────────────────────────────────────────────────────
APP_NAME=Standard-El-Joumla
ENVIRONMENT=staging
DEBUG=true
LOG_LEVEL=INFO
API_VERSION=v1

# ── API Server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=true

# ── Database ──────────────────────────────────────────────────────────────
DB_TYPE=sqlite
DATABASE_PATH=data/erp_staging.db
# For PostgreSQL staging:
# DB_TYPE=postgres
# DATABASE_URL=postgresql://erp_user:CHANGE_ME@postgres-staging:5432/erp_staging

# ── Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8
JWT_REFRESH_EXPIRY_HOURS=72
ENABLE_2FA=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Cache ─────────────────────────────────────────────────────────────────
CACHE_USE_REDIS=false
# REDIS_URL=redis://redis-staging:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://staging.erp.standard-eljoumla.com

# ── Feature Flags ─────────────────────────────────────────────────────────
FEATURE_FLAGS_PATH=config/feature_flags.json
# Override individual features via env:
# FEATURE_NEW_DASHBOARD=on
# FEATURE_NEW_PRICING_ENGINE=off
# FEATURE_AI_PREDICTIONS=on

# ── Monitoring ────────────────────────────────────────────────────────────
ENABLE_METRICS=true
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=60/minute
RATE_LIMIT_SYNC=10/minute

# ── Backup ────────────────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_DIR=data/backups
BACKUP_MAX_COUNT=10

# ── Logging & Observability ──────────────────────────────────────────────
LOG_FORMAT=json
LOG_FILE=logs/erp_staging.log
LOG_MAX_SIZE_MB=50
LOG_BACKUP_COUNT=5
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# SENTRY_ENVIRONMENT=staging

# ── Email (for notifications) ────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=erp@example.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM=erp@example.com

# ── Encryption ────────────────────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_TO_A_VALID_FERNET_KEY

# ── Deployment Tracking ──────────────────────────────────────────────────
DEPLOY_COLOR=blue
DEPLOY_VERSION=latest
HEALTH_CHECK_TIMEOUT=30
ROLLBACK_ON_FAILURE=true

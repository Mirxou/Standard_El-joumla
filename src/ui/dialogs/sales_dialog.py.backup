        buttons_h_layout.setSpacing(10)
        
        # زر الإلغاء (يسار)
        self.cancel_button = QPushButton("إلغاء (Esc)")
        self.cancel_button.setObjectName("BtnSecondary")
        self.cancel_button.setFixedHeight(55)
        buttons_h_layout.addWidget(self.cancel_button)
        
        # زر الحفظ والطباعة (يمين - Primary)
        self.save_and_print_button = QPushButton("🖨️ حفظ وطباعة (F10)")
        self.save_and_print_button.setObjectName("BtnPrimary")
        self.save_and_print_button.setFixedHeight(55)
        buttons_h_layout.addWidget(self.save_and_print_button, 2)  # يأخذ مساحة أكبر
        
        layout.addLayout(buttons_h_layout)
        
        # زر الحفظ فقط (اختياري - يمكن إخفاؤه)
        self.save_button = QPushButton("💾 حفظ فقط")
        self.save_button.setFixedHeight(45)
        self.save_button.setStyleSheet("""
            QPushButton {
                background-color: #10b981;
                color: white;
                font-size: 14px;
                font-weight: 600;
                border-radius: 8px;
                font-family: 'Segoe UI', 'Cairo', sans-serif;
            }
            QPushButton:hover {
                background-color: #059669;
            }
            QPushButton:pressed {
                background-color: #047857;
            }
        """)
        layout.addWidget(self.save_button)
        
        return card
    
    def setup_product_completer(self):
        """إعداد QCompleter للبحث الذكي"""
        # جلب جميع المنتجات للقائمة
        try:
            all_products = self.product_manager.get_all_products()
            product_names = [f"{p.name} ({p.barcode or 'بدون باركود'})" for p in all_products if p.is_active]
            
            # إنشاء Completer
            completer = QCompleter(product_names, self.product_search_edit)
            completer.setCaseSensitivity(Qt.CaseInsensitive)
            completer.setFilterMode(Qt.MatchContains)
            completer.setCompletionMode(QCompleter.PopupCompletion)
            
            self.product_search_edit.setCompleter(completer)
            
            # ربط حدث اختيار المنتج
            completer.activated.connect(self.on_product_selected)
            
        except Exception as e:
            self.logger.error(f"خطأ في إعداد Completer: {str(e)}")
    
    def on_product_selected(self, text: str):
        """معالجة اختيار منتج من القائمة المنسدلة"""
        try:
            # استخراج اسم المنتج (قبل الأقواس)
            product_name = text.split("(")[0].strip()
            
            # البحث عن المنتج
            products = self.product_manager.search_products(product_name)
            if products:
                product = products[0]
                # إضافة المنتج مباشرة
                stock_quantity = getattr(product, "stock_quantity", getattr(product, "current_stock", 0))
                min_stock_level = getattr(product, "min_stock_level", getattr(product, "min_stock", 0))
                track_stock = getattr(product, "track_stock", True)
                self.add_product_to_sale(product, track_stock, stock_quantity, min_stock_level)
                self.product_search_edit.clear()
        except Exception as e:
            self.logger.error(f"خطأ في اختيار المنتج: {str(e)}")
    
    def on_table_clicked(self, index):
        """معالجة النقر على الجدول (للحذف)"""
        if index.column() == 6:  # عمود الحذف
            row = index.row()
            if 0 <= row < len(self.sale_items):
                item = self.sale_items[row]
                reply = QMessageBox.question(
                    self,
                    "تأكيد الحذف",
                    f"هل تريد حذف '{item.product_name}' من الفاتورة؟",
                    QMessageBox.Yes | QMessageBox.No
                )
                
                if reply == QMessageBox.Yes:
                    self.invoice_model.remove_item(row)
                    self.sale_items.pop(row)
                    self.calculate_totals()
    
    def create_invoice_table_panel(self) -> QWidget:
        """إنشاء لوحة جدول الفاتورة (70% من الشاشة)"""
        widget = QWidget()
        widget.setStyleSheet("""
            QWidget {
                background-color: #f3f4f6;
            }
        """)
        
        layout = QVBoxLayout(widget)
        layout.setSpacing(0)
        layout.setContentsMargins(20, 20, 20, 20)
        
        # جدول عناصر الفاتورة - QTableView عالي الأداء
        self.invoice_model = InvoiceTableModel(self.sale_items, self)
        self.items_table = QTableView()
        self.items_table.setModel(self.invoice_model)
        
        # إعداد الأعمدة
        header = self.items_table.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.Fixed)  # #
        header.resizeSection(0, 50)
        header.setSectionResizeMode(1, QHeaderView.Stretch)  # المنتج
        header.setSectionResizeMode(2, QHeaderView.ResizeToContents)  # السعر
        header.setSectionResizeMode(3, QHeaderView.ResizeToContents)  # الكمية
        header.setSectionResizeMode(4, QHeaderView.ResizeToContents)  # الخصم
        header.setSectionResizeMode(5, QHeaderView.ResizeToContents)  # الإجمالي
        header.setSectionResizeMode(6, QHeaderView.Fixed)  # حذف
        header.resizeSection(6, 60)
        
        # إعدادات الجدول - محسّنة
        self.items_table.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.items_table.setAlternatingRowColors(True)
        self.items_table.setShowGrid(False)
        self.items_table.verticalHeader().setVisible(False)
        self.items_table.setEditTriggers(QAbstractItemView.DoubleClicked | QAbstractItemView.SelectedClicked)
        self.items_table.setVerticalScrollMode(QAbstractItemView.ScrollPerPixel)
        
        # ربط حدث النقر على عمود الحذف
        self.items_table.clicked.connect(self.on_table_clicked)
        
        # إعداد ScrollBar للجدول - واضح وسهل الاستخدام
        self.items_table.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        self.items_table.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        
        # عنوان الجدول
        header_label = QLabel("🛒 محتويات الفاتورة")
        header_label.setStyleSheet("""
            font-size: 20px;
            font-weight: bold;
            color: #1e293b;
            margin-bottom: 15px;
            font-family: 'Segoe UI', 'Cairo', sans-serif;
        """)
        layout.addWidget(header_label)
        
        # Card Frame للجدول
        table_frame = QFrame()
        table_frame.setStyleSheet("""
            QFrame {
                background-color: #ffffff;
                border-radius: 12px;
                border: 1px solid #e5e7eb;
            }
        """)
        table_layout = QVBoxLayout(table_frame)
        table_layout.setContentsMargins(0, 0, 0, 0)
        table_layout.addWidget(self.items_table)
        
        layout.addWidget(table_frame, 1)  # stretch factor = 1 للتوسع
        
        return widget
    
    def setup_connections(self):
        """إعداد الاتصالات"""
        # البحث عن المنتجات - إضافة تلقائية عند Enter
        self.product_search_edit.returnPressed.connect(self.on_search_enter_pressed)
        
        # العميل
        self.customer_combo.currentTextChanged.connect(self.on_customer_changed)
        self.new_customer_button.clicked.connect(self.add_new_customer)
        
        # الحسابات
        self.discount_spin.valueChanged.connect(self.calculate_totals)
        self.discount_percent_button.toggled.connect(self.on_discount_type_changed)
        
        # تحديث المجاميع عند تعديل العناصر
        self.invoice_model.dataChanged.connect(self.on_item_data_changed)
        
        # الأزرار
        self.save_button.clicked.connect(self.handle_save)
        self.save_and_print_button.clicked.connect(self.handle_save_and_print)
        self.cancel_button.clicked.connect(self.reject)
    
    def on_search_enter_pressed(self):
        """معالجة الضغط على Enter في البحث أو الضغط على زر الإضافة"""
        search_term = self.product_search_edit.text().strip()
        if not search_term:
            QMessageBox.warning(self, "تنبيه", "يرجى إدخال اسم المنتج أو الباركود")
            return
        
        # البحث عن المنتج
        try:
            product = None
            
            # استخراج الباركود من النص إذا كان بين قوسين (مثل: "منتج 1000 (1391881226731)")
            import re
            barcode_match = re.search(r'\((\d+)\)', search_term)
            extracted_barcode = None
            if barcode_match:
                extracted_barcode = barcode_match.group(1)
            
            # البحث بالباركود المستخرج أولاً
            if extracted_barcode:
                try:
                    product = self.product_manager.get_product_by_barcode(extracted_barcode)
                    if product and self.logger:
                        self.logger.debug(f"تم العثور على المنتج بالباركود المستخرج: {extracted_barcode}")
                except Exception as e:
                    if self.logger:
                        self.logger.debug(f"البحث بالباركود المستخرج فشل: {e}")
            
            # البحث بالباركود إذا كان النص كله أرقام
            if not product and search_term.isdigit():
                try:
                    product = self.product_manager.get_product_by_barcode(search_term)
                    if product and self.logger:
                        self.logger.debug(f"تم العثور على المنتج بالباركود: {search_term}")
                except Exception as e:
                    if self.logger:
                        self.logger.debug(f"البحث بالباركود فشل: {e}")
            
            # البحث بالمعرف إذا كان النص رقم (ID)
            if not product and search_term.isdigit():
                try:
                    product_id = int(search_term)
                    product = self.product_manager.get_product_by_id(product_id)
                    if product and self.logger:
                        self.logger.debug(f"تم العثور على المنتج بالمعرف: {product_id}")
                except Exception as e:
                    if self.logger:
                        self.logger.debug(f"البحث بالمعرف فشل: {e}")
            
            # البحث بالاسم (أكثر مرونة)
            if not product:
                try:
                    # البحث بدون فلتر is_active أولاً (لنرى جميع المنتجات)
                    products = self.product_manager.search_products(search_term, active_only=False)
                    if products:
                        # البحث عن منتج مفعّل أولاً
                        for p in products:
                            if p.is_active:
                                product = p
                                break
                        # إذا لم نجد منتج مفعّل، نأخذ الأول (لإظهار رسالة أن المنتج غير مفعّل)
                        if not product:
                            product = products[0]
                        if self.logger:
                            self.logger.debug(f"تم العثور على {len(products)} منتج بالاسم: {search_term}")
                except Exception as e:
                    if self.logger:
                        self.logger.debug(f"البحث بالاسم فشل: {e}")
            
            # التحقق من وجود المنتج
            if not product:
                QMessageBox.warning(
                    self, 
                    "لم يتم العثور على المنتج", 
                    f"لم يتم العثور على منتج بالاسم أو الباركود: '{search_term}'\n\nيرجى التحقق من:\n- صحة اسم المنتج\n- صحة الباركود\n- أن المنتج مفعّل"
                )
                return
            
            # التحقق من أن المنتج مفعّل
            if not product.is_active:
                QMessageBox.warning(
                    self, 
                    "منتج غير مفعّل", 
                    f"المنتج '{product.name}' غير مفعّل حالياً.\n\nيرجى تفعيل المنتج من صفحة المخزون أولاً."
                )
                return
            
            # إضافة المنتج إلى الفاتورة
            stock_quantity = getattr(product, "stock_quantity", getattr(product, "current_stock", 0))
            min_stock_level = getattr(product, "min_stock_level", getattr(product, "min_stock", 0))
            track_stock = getattr(product, "track_stock", True)
            
            self.add_product_to_sale(product, track_stock, stock_quantity, min_stock_level)
            self.product_search_edit.clear()
            self.product_search_edit.setFocus()  # إعادة التركيز على البحث
            
        except Exception as e:
            error_msg = f"خطأ في البحث عن المنتج: {str(e)}"
            self.logger.error(error_msg, exc_info=True)
            QMessageBox.critical(self, "خطأ", error_msg)
    
    def on_item_data_changed(self, top_left, bottom_right, roles):
        """معالجة تغيير بيانات العناصر"""
        if Qt.EditRole in roles:
            self.calculate_totals()
    
    def setup_shortcuts(self):
        """إعداد اختصارات لوحة المفاتيح"""
        # F1 - البحث
        search_shortcut = QShortcut(QKeySequence("F1"), self)
        search_shortcut.activated.connect(lambda: self.product_search_edit.setFocus())
        
        # F2 - عميل جديد
        customer_shortcut = QShortcut(QKeySequence("F2"), self)
        customer_shortcut.activated.connect(self.add_new_customer)
        
        # F3 - خصم
        discount_shortcut = QShortcut(QKeySequence("F3"), self)
        discount_shortcut.activated.connect(lambda: self.discount_spin.setFocus())
        
        # F10 - حفظ وطباعة
        save_print_shortcut = QShortcut(QKeySequence("F10"), self)
        save_print_shortcut.activated.connect(self.handle_save_and_print)
        
        # F12 - حفظ
        save_shortcut = QShortcut(QKeySequence("F12"), self)
        save_shortcut.activated.connect(self.handle_save)
        
        # Escape - إلغاء
        cancel_shortcut = QShortcut(QKeySequence("Escape"), self)
        cancel_shortcut.activated.connect(self.reject)
    

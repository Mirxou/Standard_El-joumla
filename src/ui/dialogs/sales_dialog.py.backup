    def create_summary_row(self, layout, title: str, value: str, is_minus: bool = False) -> QLabel:
        """إنشاء صف ملخص (عنوان + قيمة)"""
        row_widget = QWidget()
        row_layout = QHBoxLayout(row_widget)
        row_layout.setContentsMargins(0, 0, 0, 0)
        
        lbl_title = QLabel(title + ":")
        lbl_title.setStyleSheet("font-size: 14px; color: #6b7280;")
        row_layout.addWidget(lbl_title)
        row_layout.addStretch()
        
        lbl_value = QLabel(value + " د.ج")
        color = "#ef4444" if is_minus else "#1f2937"
        lbl_value.setStyleSheet(f"font-size: 16px; font-weight: bold; color: {color};")
        lbl_value.setAlignment(Qt.AlignRight)
        row_layout.addWidget(lbl_value)
        
        layout.addWidget(row_widget)
        return lbl_value
    

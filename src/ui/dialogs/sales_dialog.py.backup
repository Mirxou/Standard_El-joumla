    def load_data(self):
        """تحميل البيانات من قاعدة البيانات"""
        try:
            # تحميل العملاء
            customers = self.customer_manager.get_all_customers()
            self.customer_combo.clear()
            self.customer_combo.addItem("-- عميل نقدي --", None)
            for customer in customers:
                if customer.is_active:
                    self.customer_combo.addItem(f"{customer.name} - {customer.phone or 'بدون هاتف'}", customer.id)
                    
        except Exception as e:
            self.logger.error(f"خطأ في تحميل البيانات: {str(e)}")
            QMessageBox.critical(self, "خطأ", f"فشل في تحميل البيانات: {str(e)}")
    
    def create_new_sale(self):
        """إنشاء فاتورة جديدة - بدون حفظ في قاعدة البيانات حتى يتم إضافة المنتجات"""
        try:
            from ...models.sale import Sale, SaleStatus, PaymentMethod
            from datetime import date
            
            # إنشاء كائن فاتورة جديد (في الذاكرة فقط - لا يتم حفظه في قاعدة البيانات حتى الآن)
            new_sale = Sale(
                id=None,  # سيتم تعيينه عند الحفظ
                invoice_number=self._generate_invoice_number(),
                sale_date=date.today(),
                status=SaleStatus.DRAFT,
                payment_method=PaymentMethod.CASH,
                items=[],
                subtotal=Decimal('0.00'),
                discount_amount=Decimal('0.00'),
                discount_percentage=Decimal('0.00'),
                tax_amount=Decimal('0.00'),
                tax_percentage=Decimal('0.00'),
                total_amount=Decimal('0.00'),
                paid_amount=Decimal('0.00'),
                remaining_amount=Decimal('0.00')
            )
            
            # حفظ الفاتورة في الذاكرة فقط (سيتم حفظها في قاعدة البيانات عند الضغط على "حفظ")
            self.sale = new_sale
            self.invoice_number_label.setText(f"رقم الفاتورة: {self.sale.invoice_number}")
            
            if self.logger:
                self.logger.debug(f"✅ تم إنشاء فاتورة جديدة في الذاكرة: {self.sale.invoice_number}")
                
        except Exception as e:
            error_msg = f"خطأ في إنشاء فاتورة جديدة: {str(e)}"
            self.logger.error(error_msg, exc_info=True)
            QMessageBox.critical(self, "خطأ", error_msg)
            self.reject()
    
    def _generate_invoice_number(self):
        """توليد رقم فاتورة جديد"""
        from datetime import datetime
        timestamp = datetime.now().strftime("%Y%m%d%H%M%S")
        return f"INV-{timestamp}"
    
    def populate_form(self):
        """ملء النموذج ببيانات الفاتورة (للتعديل)"""
        if not self.sale:
            return
        
        try:
            # معلومات الفاتورة
            self.invoice_number_label.setText(f"رقم الفاتورة: {self.sale.invoice_number}")
            self.date_label.setText(f"التاريخ: {self.sale.sale_date}")
            
            # العميل
            if self.sale.customer_id:
                index = self.customer_combo.findData(self.sale.customer_id)
                if index >= 0:
                    self.customer_combo.setCurrentIndex(index)
            
            # الخصم
            self.discount_spin.setValue(float(self.sale.discount_amount or 0))
            
            # تحميل عناصر الفاتورة
            self.load_sale_items()
            
        except Exception as e:
            self.logger.error(f"خطأ في ملء النموذج: {str(e)}")
            QMessageBox.critical(self, "خطأ", f"فشل في تحميل بيانات الفاتورة: {str(e)}")
    
    def load_sale_items(self):
        """تحميل عناصر الفاتورة"""
        if not self.sale:
            return
        
        try:
            # جلب عناصر الفاتورة من قاعدة البيانات
            items = self.sale_manager.get_sale_items(self.sale.id)
            self.sale_items = items
            self.refresh_items_table()
            
        except Exception as e:
            self.logger.error(f"خطأ في تحميل عناصر الفاتورة: {str(e)}")
    
    
    
    def add_product_to_sale(self, product, track_stock=True, stock_quantity=None, min_stock_level=None):
        """إضافة منتج إلى الفاتورة"""
        try:
            if not product:
                QMessageBox.warning(self, "تحذير", "المنتج غير موجود")
                return
            
            if stock_quantity is None:
                stock_quantity = getattr(product, "stock_quantity", getattr(product, "current_stock", 0))
            if min_stock_level is None:
                min_stock_level = getattr(product, "min_stock_level", getattr(product, "min_stock", 0))
            track_stock = getattr(product, "track_stock", track_stock)
            
            # التحقق من المخزون
            if track_stock and stock_quantity <= 0:
                QMessageBox.warning(self, "تحذير", f"المنتج '{product.name}' غير متوفر في المخزون")
                return
            
            # البحث عن المنتج في الفاتورة
            existing_item = None
            for item in self.sale_items:
                if item.product_id == product.id:
                    existing_item = item
                    break
            
            if existing_item:
                # زيادة الكمية
                new_quantity = existing_item.quantity + 1
                if track_stock and new_quantity > stock_quantity:
                    QMessageBox.warning(self, "تحذير", f"الكمية المطلوبة ({new_quantity}) أكبر من المتوفر في المخزون ({stock_quantity})")
                    return
                
                existing_item.quantity = new_quantity
                existing_item.total_amount = existing_item.unit_price * existing_item.quantity - existing_item.discount_amount
                
                # تحديث العنصر في Model
                if hasattr(self, 'invoice_model') and self.invoice_model:
                    try:
                        item_index = self.sale_items.index(existing_item)
                        self.invoice_model.update_item(item_index, existing_item)
                    except Exception as e:
                        if self.logger:
                            self.logger.debug(f"فشل تحديث العنصر في Model: {e}")
                        # إعادة تحديث الجدول بالكامل
                        self.refresh_items_table()
            else:
                # إضافة عنصر جديد
                sale_item = SaleItem(
                    id=None,
                    sale_id=self.sale.id if self.sale else None,
                    product_id=product.id,
                    product_name=product.name,
                    quantity=1,
                    unit_price=product.selling_price,
                    discount_amount=Decimal('0'),
                    total_amount=product.selling_price
                )
                self.sale_items.append(sale_item)
                
                # إضافة العنصر إلى Model مباشرة
                if hasattr(self, 'invoice_model') and self.invoice_model:
                    try:
                        self.invoice_model.add_item(sale_item)
                        if self.logger:
                            self.logger.debug(f"تم إضافة العنصر إلى Model مباشرة")
                    except Exception as e:
                        if self.logger:
                            self.logger.debug(f"فشل إضافة العنصر إلى Model: {e}")
                        # إعادة تحديث الجدول بالكامل
                        self.refresh_items_table()
                else:
                    # إذا لم يكن Model موجود، إنشاؤه
                    self.refresh_items_table()
            
            # تحديث الجدول والحسابات (للتأكد)
            if existing_item:
                # إذا كان عنصر موجود، تم تحديثه أعلاه، لكن نحدث الجدول للتأكد
                self.items_table.viewport().update()
            else:
                # إذا كان عنصر جديد، تم إضافته أعلاه
                self.items_table.viewport().update()
            
            self.calculate_totals()
            
            # مسح البحث وإعادة التركيز
            self.product_search_edit.clear()
            self.product_search_edit.setFocus()
            
            # رسالة نجاح (اختيارية - يمكن إزالتها لاحقاً)
            if self.logger:
                self.logger.debug(f"✅ تم إضافة المنتج '{product.name}' إلى الفاتورة بنجاح - الكمية: {existing_item.quantity if existing_item else 1}")
            
        except Exception as e:
            error_msg = f"فشل في إضافة المنتج: {str(e)}"
            self.logger.error(error_msg, exc_info=True)
            QMessageBox.critical(self, "خطأ", error_msg)
    
    def refresh_items_table(self):
        """تحديث جدول عناصر الفاتورة - استخدام InvoiceTableModel"""
        try:
            # التأكد من وجود Model
            if not hasattr(self, 'invoice_model') or not self.invoice_model:
                self.invoice_model = InvoiceTableModel(self.sale_items, self)
                self.items_table.setModel(self.invoice_model)
                self.invoice_model.dataChanged.connect(self.on_item_data_changed)
            
            # تحديث Model
            self.invoice_model.clear()
            for item in self.sale_items:
                self.invoice_model.add_item(item)
            
            # التأكد من تحديث الجدول
            self.items_table.viewport().update()
            self.items_table.update()
            
            if self.logger:
                self.logger.debug(f"✅ تم تحديث الجدول - عدد العناصر: {len(self.sale_items)}")
            
        except Exception as e:
            self.logger.error(f"خطأ في تحديث الجدول: {str(e)}", exc_info=True)
            # محاولة إعادة إنشاء Model
            try:
                self.invoice_model = InvoiceTableModel(self.sale_items, self)
                self.items_table.setModel(self.invoice_model)
                self.invoice_model.dataChanged.connect(self.on_item_data_changed)
                if self.logger:
                    self.logger.debug("✅ تم إعادة إنشاء Model بنجاح")
            except Exception as e2:
                self.logger.error(f"فشل إعادة إنشاء Model: {str(e2)}", exc_info=True)
    
    def update_item_quantity(self, row: int, quantity: int):
        """تحديث كمية العنصر (يتم استدعاؤها من Model)"""
        if row < len(self.sale_items):
            item = self.sale_items[row]
            
            # التحقق من المخزون
            product = self.product_manager.get_product_by_id(item.product_id)
            track_stock = getattr(product, "track_stock", True) if product else True
            stock_quantity = getattr(product, "stock_quantity", getattr(product, "current_stock", 0)) if product else 0
            
            if track_stock and product and quantity > stock_quantity:
                QMessageBox.warning(self, "تحذير", f"الكمية المطلوبة ({quantity}) أكبر من المتوفر في المخزون ({stock_quantity})")
                # إعادة القيمة القديمة
                self.invoice_model.refresh()
                return
            
            item.quantity = quantity
            item.total_amount = item.unit_price * item.quantity - item.discount_amount
            self.calculate_totals()
    
    def update_item_discount(self, row: int, discount: float):
        """تحديث خصم العنصر (يتم استدعاؤها من Model)"""
        if row < len(self.sale_items):
            item = self.sale_items[row]
            item.discount_amount = Decimal(str(discount))
            item.total_amount = item.unit_price * item.quantity - item.discount_amount
            self.calculate_totals()
    
    def calculate_totals(self):
        """حساب المجاميع - باستخدام Decimal للدقة"""
        try:
            # المجموع الفرعي - استخدام Decimal
            subtotal = Decimal('0')
            for item in self.sale_items:
                item_total = to_decimal(item.total_amount)
                subtotal += item_total
            
            # الخصم
            discount_value = to_decimal(self.discount_spin.value())
            if hasattr(self, 'discount_percent_button') and self.discount_percent_button.isChecked():
                # خصم بالنسبة المئوية
                discount = calculate_discount_amount(subtotal, discount_percentage=discount_value)
            else:
                # خصم بالمبلغ
                discount = discount_value
            
            # المجموع بعد الخصم
            after_discount = subtotal - discount
            
            # الضريبة (tax_rate هو Decimal مثل 0.15 = 15%)
            tax_amount = calculate_tax_amount(after_discount, self.tax_rate * Decimal('100'))
            
            # المجموع الكلي
            total = calculate_grand_total(subtotal, discount, tax_amount)
            
            # تحديث التسميات
            self.subtotal_label.setText(f"{subtotal:.2f} د.ج")
            if hasattr(self, 'discount_label'):
                self.discount_label.setText(f"{discount:.2f} د.ج")
            self.tax_label.setText(f"{tax_amount:.2f} د.ج")
            self.total_label.setText(f"{total:.2f} د.ج")
            
            # حفظ القيم
            self.discount_amount = discount
            
        except Exception as e:
            self.logger.error(f"خطأ في حساب المجاميع: {str(e)}", exc_info=True)
            # محاولة حساب بسيط كبديل
            try:
                subtotal = sum(to_decimal(item.total_amount) for item in self.sale_items)
                discount = to_decimal(self.discount_spin.value())
                if hasattr(self, 'discount_percent_button') and self.discount_percent_button.isChecked():
                    discount = subtotal * (discount / Decimal('100'))
                after_discount = subtotal - discount
                tax_amount = after_discount * self.tax_rate
                total = after_discount + tax_amount
                
                self.subtotal_label.setText(f"{subtotal:.2f} د.ج")
                if hasattr(self, 'discount_label'):
                    self.discount_label.setText(f"{discount:.2f} د.ج")
                self.tax_label.setText(f"{tax_amount:.2f} د.ج")
                self.total_label.setText(f"{total:.2f} د.ج")
                self.discount_amount = discount
            except Exception as e2:
                self.logger.error(f"فشل الحساب البديل: {str(e2)}", exc_info=True)
    
    def on_discount_type_changed(self, is_percentage: bool):
        """معالجة تغيير نوع الخصم"""
        if is_percentage:
            self.discount_spin.setSuffix("%")
            self.discount_spin.setRange(0, 100)
        else:
            self.discount_spin.setSuffix(" د.ج")
            self.discount_spin.setRange(0, 999999.99)
        
        self.calculate_totals()
    
    def on_customer_changed(self, customer_text: str):
        """معالجة تغيير العميل"""
        customer_id = self.customer_combo.currentData()
        if customer_id:
            try:
                customer = self.customer_manager.get_customer_by_id(customer_id)
                if customer:
                    self.current_customer = customer
                    info_text = f"الهاتف: {customer.phone or 'غير محدد'}"
                    if customer.credit_limit > 0:
                        info_text += f" | الحد الائتماني: {customer.credit_limit:.2f}"
                    if customer.current_balance > 0:
                        info_text += f" | الرصيد الحالي: {customer.current_balance:.2f}"
                    self.customer_info_label.setText(info_text)
                else:
                    self.current_customer = None
                    self.customer_info_label.setText("عميل غير موجود")
            except Exception as e:
                self.logger.error(f"خطأ في تحميل بيانات العميل: {str(e)}")
                self.customer_info_label.setText("خطأ في تحميل بيانات العميل")
        else:
            self.current_customer = None
            self.customer_info_label.setText("عميل نقدي")
    
    def add_new_customer(self):
        """إضافة عميل جديد"""
        try:
            from .customer_dialog import CustomerDialog
            
            dialog = CustomerDialog(self.db_manager, parent=self)
            if dialog.exec() == QDialog.Accepted:
                # إعادة تحميل العملاء
                self.load_data()
                
                # اختيار العميل الجديد
                new_customer = dialog.get_saved_customer()
                if new_customer:
                    index = self.customer_combo.findData(new_customer.id)
                    if index >= 0:
                        self.customer_combo.setCurrentIndex(index)
                        
        except ImportError:
            QMessageBox.information(self, "معلومات", "نافذة إضافة العملاء غير متوفرة حالياً")
        except Exception as e:
            self.logger.error(f"خطأ في إضافة عميل جديد: {str(e)}")
            QMessageBox.critical(self, "خطأ", f"فشل في إضافة عميل جديد: {str(e)}")
    
    def clear_invoice(self):
        """مسح الفاتورة"""
        reply = QMessageBox.question(
            self, 
            "تأكيد المسح", 
            "هل تريد مسح جميع عناصر الفاتورة؟",
            QMessageBox.Yes | QMessageBox.No
        )
        
        if reply == QMessageBox.Yes:
            self.sale_items.clear()
            self.refresh_items_table()
            self.calculate_totals()
            self.product_search_edit.clear()
    
    def hold_invoice(self):
        """تعليق الفاتورة"""
        try:
            if not self.sale_items:
                QMessageBox.warning(self, "تحذير", "لا يمكن تعليق فاتورة فارغة")
                return
            
            # حفظ الفاتورة بحالة معلقة
            self.save_sale(status=SaleStatus.PENDING)
            QMessageBox.information(self, "نجح", "تم تعليق الفاتورة بنجاح")
            self.accept()
            
        except Exception as e:
            self.logger.error(f"خطأ في تعليق الفاتورة: {str(e)}")
            QMessageBox.critical(self, "خطأ", f"فشل في تعليق الفاتورة: {str(e)}")
    
    def print_invoice(self):
        """طباعة الفاتورة"""
        try:
            if not self.sale or not self.sale_items:
                QMessageBox.warning(self, "تحذير", "لا يمكن طباعة فاتورة فارغة")
                return
            
            # هنا يمكن إضافة كود الطباعة
            QMessageBox.information(self, "معلومات", "سيتم إضافة وظيفة الطباعة قريباً")
            
        except Exception as e:
            self.logger.error(f"خطأ في طباعة الفاتورة: {str(e)}")
            QMessageBox.critical(self, "خطأ", f"فشل في طباعة الفاتورة: {str(e)}")
    
    def handle_save(self):
        """معالجة حفظ الفاتورة"""
        self.save_sale()
    
    def handle_save_and_print(self):
        """معالجة حفظ وطباعة الفاتورة"""
        if self.save_sale():
            self.print_invoice()
    
    def save_sale(self, status: SaleStatus = SaleStatus.CONFIRMED) -> bool:
        """حفظ الفاتورة - استخدام SaleManager مباشرة"""
        try:
            if not self.sale_items:
                QMessageBox.warning(self, "تحذير", "لا يمكن حفظ فاتورة فارغة")
                return False
            
            # تعطيل الواجهة أثناء الحفظ
            self.set_ui_enabled(False)
            self.progress_bar.setVisible(True)
            
            # تحديث بيانات الفاتورة
            customer_id = self.customer_combo.currentData()
            if customer_id and isinstance(customer_id, int):
                customer = self.customer_manager.get_customer(customer_id)
                customer_name = customer.name if customer else None
                customer_phone = customer.phone if customer else None
            else:
                customer_id = None
                customer_name = None
                customer_phone = None
            
            payment_method = PaymentMethod.CASH  # افتراضي
            notes = getattr(self, 'notes_edit', None)
            if notes:
                notes = notes.toPlainText().strip() or ""
            else:
                notes = ""
            
            # حساب المجاميع النهائية
            subtotal = sum(item.total_amount for item in self.sale_items)
            discount_amount = self.discount_amount
            tax_amount = (subtotal - discount_amount) * self.tax_rate
            total_amount = subtotal + tax_amount - discount_amount
            remaining_amount = total_amount  # لم يتم الدفع بعد
            
            # تحديث بيانات الفاتورة
            self.sale.customer_id = customer_id
            self.sale.customer_name = customer_name
            self.sale.customer_phone = customer_phone
            self.sale.status = status
            self.sale.payment_method = payment_method
            self.sale.subtotal = subtotal
            self.sale.discount_amount = discount_amount
            self.sale.tax_amount = tax_amount
            self.sale.total_amount = total_amount
            self.sale.remaining_amount = remaining_amount
            self.sale.notes = notes
            self.sale.items = self.sale_items.copy()
            
            # حفظ الفاتورة في قاعدة البيانات باستخدام SaleManager
            if self.sale.id is None:
                # إنشاء فاتورة جديدة
                sale_id = self.sale_manager.create_sale(self.sale)
                if sale_id:
                    self.sale.id = sale_id
                    if self.logger:
                        self.logger.info(f"✅ تم إنشاء فاتورة جديدة: {self.sale.invoice_number} (ID: {sale_id})")
                else:
                    raise Exception("فشل في إنشاء الفاتورة في قاعدة البيانات")
            else:
                # تحديث فاتورة موجودة
                # TODO: إضافة دالة update_sale في SaleManager
                raise Exception("تحديث الفاتورة غير مدعوم حالياً")
            
            # إكمال الفاتورة
            completed_sale = self.sale
            
            # إطلاق الإشارات: إعلام النظام بالتغييرات
            try:
                from ...core.signals import signals
                signals.sales_updated.emit()
                signals.sale_created.emit(completed_sale.id if hasattr(completed_sale, 'id') and completed_sale.id else 0)
                signals.inventory_updated.emit()
                if self.logger:
                    self.logger.debug(f"✅ تم إطلاق إشارات: sales_updated, sale_created, inventory_updated")
            except Exception as e:
                if self.logger:
                    self.logger.warning(f"⚠️ فشل إطلاق الإشارات: {e}")
            
            self.sale_completed.emit(completed_sale)
            
            QMessageBox.information(
                self, 
                "نجح", 
                f"تم حفظ الفاتورة بنجاح\nرقم الفاتورة: {completed_sale.invoice_number}\nالمجموع: {total_amount:.2f} د.ج"
            )
            
            self.accept()
            return True
                
        except Exception as e:
            self.logger.error(f"خطأ في حفظ الفاتورة: {str(e)}")
            QMessageBox.critical(self, "خطأ", f"فشل في حفظ الفاتورة: {str(e)}")
            return False
        finally:
            self.set_ui_enabled(True)
            self.progress_bar.setVisible(False)
    
    def set_ui_enabled(self, enabled: bool):
        """تفعيل/تعطيل عناصر الواجهة"""
        self.product_search_edit.setEnabled(enabled)
        self.customer_combo.setEnabled(enabled)
        self.new_customer_button.setEnabled(enabled)
        self.discount_spin.setEnabled(enabled)
        self.items_table.setEnabled(enabled)
        self.save_button.setEnabled(enabled)
        self.save_and_print_button.setEnabled(enabled)
        self.cancel_button.setEnabled(enabled)
    
    def closeEvent(self, event):
        """معالجة إغلاق النافذة"""
        if self.search_worker and self.search_worker.isRunning():
            self.search_worker.terminate()
            self.search_worker.wait()
        
        # التحقق من وجود تغييرات غير محفوظة
        if self.sale_items and not self.is_edit_mode:
            reply = QMessageBox.question(
                self,
                "تأكيد الإغلاق",
                "هناك فاتورة غير محفوظة. هل تريد الإغلاق بدون حفظ؟",
                QMessageBox.Yes | QMessageBox.No
            )
            
            if reply == QMessageBox.No:
                event.ignore()
                return
        
        super().closeEvent(event)


# اختبار النافذة

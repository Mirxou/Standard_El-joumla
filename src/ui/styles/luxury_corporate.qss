/* src/ui/styles/luxury_corporate.qss */
/* Awwwards-level UI/UX Pro Max - Soft Minimalism & Corporate Tech Theme */

/* Global Typography & Colors */
* {
    font-family: "Inter", "Segoe UI", "Cairo", sans-serif;
    color: #1E293B; /* slate-800 */
}

QMainWindow, QDialog {
    background-color: #F8FAFC; /* slate-50 */
}

QWidget {
    background-color: transparent;
}

/* Base Cards & Containers - Bento Grid Foundation */
QWidget#ContentContainer, QFrame#Card, QFrame#Zone1, QFrame#Zone2, QFrame#Zone3 {
    background-color: #FFFFFF;
    border-radius: 16px;
    border: 1px solid #E2E8F0; /* slate-200 */
}

/* Smooth Interactive Buttons (Fitts Law Compliant) */
QPushButton {
    background-color: #2563EB; /* blue-600 */
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-weight: 600;
    font-size: 14px;
    min-height: 44px; /* Fitts Law Target Size */
    qproperty-cursor: 13; /* Qt::PointingHandCursor */
}

QPushButton:hover {
    background-color: #1D4ED8; /* blue-700 */
}

QPushButton:pressed {
    background-color: #1E3A8A; /* blue-900 */
}

QPushButton:disabled {
    background-color: #CBD5E1; /* slate-300 */
    color: #94A3B8; /* slate-400 */
}

/* Secondary Button / Cancel */
QPushButton.secondary, QPushButton#BtnSecondary {
    background-color: transparent;
    border: 2px solid #E2E8F0;
    color: #475569; /* slate-600 */
}

QPushButton.secondary:hover, QPushButton#BtnSecondary:hover {
    background-color: #F1F5F9;
    color: #1E293B;
}

/* CTA / Primary Button Override */
QPushButton#BtnPrimary {
    background-color: #F97316; /* orange-500 (CTA) */
    color: #FFFFFF;
}

QPushButton#BtnPrimary:hover {
    background-color: #EA580C; /* orange-600 */
}

/* Input Fields - Clean & Accessible */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    border: 2px solid #E2E8F0;
    border-radius: 8px;
    padding: 10px 14px;
    background-color: #FFFFFF;
    selection-background-color: #BFDBFE; /* blue-200 */
    selection-color: #1E3A8A;
    font-size: 14px;
    color: #1E293B;
    min-height: 44px; /* Accessible Touch Target */
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #2563EB; /* blue-600 */
    outline: none;
}

/* Dropdown styling */
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox QAbstractItemView {
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    background-color: #FFFFFF;
    selection-background-color: #F1F5F9;
    selection-color: #2563EB;
}

/* Tables - Data Dense but clean */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC; /* slate-50 for alternating rows */
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    gridline-color: #F1F5F9;
    selection-background-color: #EFF6FF; /* blue-50 */
    selection-color: #1E40AF; /* blue-800 */
    outline: none;
    font-size: 14px;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569; /* slate-600 */
    padding: 14px;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
}

QTableWidget::item {
    padding: 12px 8px;
    border-bottom: 1px solid #F1F5F9;
}

/* Invisible Minimalist Scrollbars */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px; 
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Tabs */
QTabWidget::pane { 
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    background: #FFFFFF;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    border: none;
    padding: 12px 24px;
    color: #64748B; /* slate-500 */
    font-weight: 500;
    font-size: 14px;
    border-bottom: 3px solid transparent;
}
QTabBar::tab:selected {
    color: #2563EB;
    font-weight: 600;
    border-bottom: 3px solid #2563EB;
}
QTabBar::tab:hover:!selected {
    color: #1E293B;
}

/* ToolTip */
QToolTip {
    border: 1px solid #E2E8F0;
    background-color: #1E293B; /* slate-800 */
    color: #FFFFFF;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════
   AURORA NOIR v4.0 — Tab Widget Styles
   ═══════════════════════════════════════════════════════════ */

QTabWidget::pane {
    border: 1px solid #2A3150;
    border-radius: 12px;
    background: transparent;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #515874;
    padding: 10px 22px;
    margin-left: 2px;
    border-top-right-radius: 12px;
    border-top-left-radius: 12px;
    border: 1px solid transparent;
    font-weight: 600;
    font-size: 13px;
    min-width: 90px;
    letter-spacing: 0.01em;
}

QTabBar::tab:selected {
    background: #181D2E;
    color: #C8A54E;
    border-bottom: 2px solid #C8A54E;
    border-top: 1px solid #2A3150;
    border-left: 1px solid #2A3150;
    border-right: 1px solid #2A3150;
}

QTabBar::tab:hover:!selected {
    background: rgba(200,165,78,0.05);
    color: #F0F2F5;
}

QTabBar::tab:pressed {
    background: rgba(200,165,78,0.08);
}
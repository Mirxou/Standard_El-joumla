/* ═══════════════════════════════════════════════════════════
   OBSIDIAN LUXE v3.0 — Tab Widget Styles
   ═══════════════════════════════════════════════════════════ */

QTabWidget::pane {
    border: 1px solid #282d48;
    border-radius: 12px;
    background: transparent;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #5d6184;
    padding: 10px 22px;
    margin-left: 2px;
    border-top-right-radius: 12px;
    border-top-left-radius: 12px;
    border: 1px solid transparent;
    font-weight: 600;
    font-size: 13px;
    min-width: 90px;
    letter-spacing: 0.01em;
}

QTabBar::tab:selected {
    background: #141724;
    color: #c9956b;
    border-bottom: 2px solid #c9956b;
    border-top: 1px solid #282d48;
    border-left: 1px solid #282d48;
    border-right: 1px solid #282d48;
}

QTabBar::tab:hover:!selected {
    background: rgba(201,149,107,0.05);
    color: #e8eaf0;
}

QTabBar::tab:pressed {
    background: rgba(201,149,107,0.08);
}
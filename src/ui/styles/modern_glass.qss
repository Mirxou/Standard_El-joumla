/* ═══════════════════════════════════════════════════════════════════════
   STANDARD EL-JOUMA — AURORA NOIR v4.0
   ╔═════════════════════════════════════════════════════════════════╗
   ║  World-Class Arabic ERP Design System                          ║
   ║  Deep Aurora Noir + Gold (#C8A54E) + Teal (#2DD4BF)          ║
   ║  5-layer depth architecture · RTL-first · Financial luxury    ║
   ╚═════════════════════════════════════════════════════════════════╝

   Background Layers:
     Void    : #06070B  — Outermost frame, universe
     Deep    : #0C0E16  — Window background
     Primary : #111520  — Sidebar, titlebar, main surfaces
     Surface : #181D2E  — Cards, panels, dialogs
     Raised  : #202640  — Inputs, embedded elements
     Elevate : #2A3150  — Popovers, dropdowns
     Hover   : #323C62  — Interactive hover
     Active  : #3C4875  — Pressed states

   Accent Colors:
     Gold     : #C8A54E  — Primary accent (financial, luxury)
     Teal     : #2DD4BF  — Success, growth, positive
     Coral    : #EF6B6B  — Error, danger
     Amber    : #F59E0B  — Warning, caution
     Sky      : #38BDF8  — Information, links
   ═══════════════════════════════════════════════════════════════════════ */

/* ─── GLOBAL RESET ─────────────────────────────────────── */
* {
    outline: none;
    box-sizing: border-box;
}

QWidget {
    font-family: 'Cairo', 'Noto Sans Arabic', 'Segoe UI', system-ui, sans-serif;
    font-size: 13px;
    color: #F0F2F5;
    background-color: transparent;
}

/* ─── MAIN CONTAINERS ──────────────────────────────────── */
QMainWindow {
    background-color: #06070B;
}

QWidget#centralWidget,
QStackedWidget {
    background-color: #0C0E16;
}

QFrame#mainFrame {
    background-color: #111520;
    border: 1px solid #2A3150;
    border-radius: 16px;
}

QFrame#mainFrame:hover {
    border-color: #3A4468;
}

/* ─── DIALOG ───────────────────────────────────────────── */
QDialog {
    background-color: #181D2E;
    border: 1px solid #2A3150;
    border-radius: 16px;
}

/* ─── MESSAGE BOX ──────────────────────────────────────── */
QMessageBox {
    background-color: #181D2E;
    color: #F0F2F5;
}

QMessageBox QLabel {
    color: #F0F2F5;
    font-size: 13px;
}

/* ─── SIDEBAR ──────────────────────────────────────────── */
QFrame#modernSidebar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #111520,stop:1 #0C0E16);
    border-left: 1px solid #1E2440;
}

QLabel#sidebarTitle {
    font-size: 18px;
    font-weight: 800;
    color: #C8A54E;
    letter-spacing: 0.5px;
}

QLabel#sidebarSubtitle {
    font-size: 11px;
    color: #515874;
    letter-spacing: 0.02em;
}

QPushButton#sidebarToggleBtn {
    background: transparent;
    border: none;
    color: #515874;
    font-size: 18px;
    padding: 6px;
    border-radius: 8px;
}

QPushButton#sidebarToggleBtn:hover {
    background-color: rgba(200,165,78,0.10);
    color: #C8A54E;
}

QPushButton#modernSidebarBtn {
    background-color: transparent;
    color: #8B92A8;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    text-align: right;
    font-size: 13px;
    font-weight: 500;
    border-right: 3px solid transparent;
}

QPushButton#modernSidebarBtn:hover {
    background-color: rgba(200,165,78,0.06);
    color: #F0F2F5;
    border-right: 3px solid rgba(200,165,78,0.4);
}

QPushButton#modernSidebarBtn:checked {
    background-color: rgba(200,165,78,0.12);
    color: #C8A54E;
    border-right: 3px solid #C8A54E;
    font-weight: 700;
}

QPushButton#sidebarLogoutBtn {
    background-color: transparent;
    color: #EF6B6B;
    border: 1px solid rgba(239,107,107,0.30);
    border-radius: 10px;
    padding: 10px 14px;
    text-align: right;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#sidebarLogoutBtn:hover {
    background-color: rgba(239,107,107,0.12);
    border-color: #EF6B6B;
}

/* ─── SCROLL AREA ──────────────────────────────────────── */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ─── LABELS ───────────────────────────────────────────── */
QLabel {
    color: #F0F2F5;
    background-color: transparent;
}

QLabel[class="heading"] {
    font-weight: 700;
    font-size: 18px;
    color: #FFFFFF;
}

QLabel[class="subheading"] {
    font-weight: 500;
    font-size: 14px;
    color: #8B92A8;
}

/* ─── GROUP BOX ────────────────────────────────────────── */
QGroupBox {
    color: #C8A54E;
    font-weight: 700;
    font-size: 14px;
    border: 1px solid #2A3150;
    border-radius: 12px;
    margin-top: 24px;
    padding-top: 20px;
    background-color: rgba(24,29,46,0.5);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 4px 14px;
    color: #C8A54E;
    background-color: #181D2E;
    border: 1px solid #2A3150;
    border-radius: 8px;
    right: 12px;
    font-size: 13px;
}

/* ─── BUTTONS ──────────────────────────────────────────── */
QPushButton {
    background-color: #202640;
    color: #F0F2F5;
    border: 1px solid #2A3150;
    border-radius: 10px;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 13px;
    min-height: 40px;
}

QPushButton:hover {
    background-color: #323C62;
    border-color: #3A4468;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #3C4875;
    border-color: #C8A54E;
}

QPushButton:disabled {
    background-color: #111520;
    color: #2E3550;
    border-color: #1E2440;
}

/* Primary Button — GOLD gradient */
QPushButton#primaryBtn,
QPushButton[class="primary"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #C8A54E,stop:1 #E8C96A);
    color: #111520;
    border: none;
    font-weight: 700;
    letter-spacing: 0.02em;
}

QPushButton#primaryBtn:hover,
QPushButton[class="primary"]:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #E8C96A,stop:1 #FBBF24);
    color: #0C0E16;
}

QPushButton#primaryBtn:pressed,
QPushButton[class="primary"]:pressed {
    background: #A88A3E;
    color: #0C0E16;
}

/* Amber Button — Gold gradient (financial CTA) */
QPushButton#amberBtn,
QPushButton[class="amber"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #C8A54E,stop:1 #E8C96A);
    color: #111520;
    border: none;
    font-weight: 700;
}

QPushButton#amberBtn:hover,
QPushButton[class="amber"]:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #E8C96A,stop:1 #FBBF24);
}

/* Secondary Button — GOLD outline */
QPushButton[class="secondary"] {
    background-color: transparent;
    color: #C8A54E;
    border: 2px solid #C8A54E;
    border-radius: 10px;
    padding: 10px 22px;
}

QPushButton[class="secondary"]:hover {
    background-color: rgba(200,165,78,0.12);
    color: #E8C96A;
}

QPushButton[class="secondary"]:pressed {
    background-color: rgba(200,165,78,0.18);
}

/* Flat Button */
QPushButton[flat="true"],
QPushButton[class="flat"] {
    background-color: transparent;
    color: #8B92A8;
    border: 1px solid transparent;
    border-radius: 10px;
}

QPushButton[flat="true"]:hover,
QPushButton[class="flat"]:hover {
    background-color: rgba(200,165,78,0.08);
    color: #F0F2F5;
    border-color: transparent;
}

/* Ghost Button — Most subtle */
QPushButton[class="ghost"] {
    background-color: transparent;
    color: #8B92A8;
    border: none;
    border-radius: 8px;
}

QPushButton[class="ghost"]:hover {
    background-color: rgba(200,165,78,0.06);
    color: #F0F2F5;
}

/* Danger Button — CORAL */
QPushButton[class="danger"] {
    background-color: rgba(239,107,107,0.10);
    color: #EF6B6B;
    border: 1px solid rgba(239,107,107,0.25);
}

QPushButton[class="danger"]:hover {
    background-color: rgba(239,107,107,0.18);
    border-color: #EF6B6B;
}

/* Success Button — TEAL */
QPushButton[class="success"] {
    background-color: rgba(45,212,191,0.10);
    color: #2DD4BF;
    border: 1px solid rgba(45,212,191,0.25);
}

QPushButton[class="success"]:hover {
    background-color: rgba(45,212,191,0.18);
    border-color: #2DD4BF;
}

/* Warning Button — AMBER */
QPushButton[class="warning"] {
    background-color: rgba(245,158,11,0.10);
    color: #F59E0B;
    border: 1px solid rgba(245,158,11,0.25);
}

QPushButton[class="warning"]:hover {
    background-color: rgba(245,158,11,0.18);
    border-color: #F59E0B;
}

/* Close Button */
QPushButton#closeBtn,
QPushButton[class="close"] {
    background-color: transparent;
    color: #515874;
    border: none;
    border-radius: 8px;
    padding: 6px;
    min-height: 24px;
    min-width: 24px;
    font-size: 16px;
}

QPushButton#closeBtn:hover,
QPushButton[class="close"]:hover {
    background-color: rgba(239,107,107,0.12);
    color: #EF6B6B;
}

/* ─── INPUTS ───────────────────────────────────────────── */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #202640;
    color: #F0F2F5;
    border: 1px solid #2A3150;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    selection-background-color: rgba(200,165,78,0.35);
    selection-color: #FFFFFF;
    min-height: 40px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border: 1px solid #C8A54E;
    background-color: #181D2E;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #3A4468;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #111520;
    color: #2E3550;
    border-color: #1E2440;
}

QLineEdit::placeholder,
QPlainTextEdit::placeholder {
    color: #515874;
}

/* ─── SPIN BOX BUTTONS ─────────────────────────────────── */
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: #2A3150;
    border: none;
    border-radius: 4px;
    width: 22px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: rgba(200,165,78,0.15);
}

/* ─── DATE EDIT ARROWS ─────────────────────────────────── */
QDateEdit::drop-down,
QDateTimeEdit::drop-down {
    background-color: #2A3150;
    border: none;
    border-radius: 8px;
    width: 28px;
}

/* ─── COMBOBOX ─────────────────────────────────────────── */
QComboBox {
    background-color: #202640;
    color: #F0F2F5;
    border: 1px solid #2A3150;
    border-radius: 10px;
    padding: 10px 34px 10px 14px;
    font-size: 13px;
    min-height: 40px;
}

QComboBox:hover {
    border-color: #3A4468;
}

QComboBox:focus {
    border-color: #C8A54E;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
    subcontrol-position: left center;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #2A3150;
    border: 1px solid #2A3150;
    border-radius: 12px;
    color: #F0F2F5;
    selection-background-color: rgba(200,165,78,0.18);
    selection-color: #E8C96A;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 10px 16px;
    min-height: 36px;
    border-radius: 8px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(200,165,78,0.10);
}

/* ─── TABLES ───────────────────────────────────────────── */
QTableWidget,
QTableView {
    background-color: #111520;
    alternate-background-color: #0C0E16;
    color: #F0F2F5;
    gridline-color: #1E2440;
    border: 1px solid #2A3150;
    border-radius: 12px;
    font-size: 12px;
    selection-background-color: rgba(200,165,78,0.18);
    selection-color: #E8C96A;
}

QTableWidget::item,
QTableView::item {
    padding: 10px 14px;
    color: #F0F2F5;
    border-bottom: 1px solid #1E2440;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: rgba(200,165,78,0.18);
    color: #E8C96A;
    border: none;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #1E2440;
}

QHeaderView {
    background-color: #111520;
}

QHeaderView::section {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #202640,stop:1 #181D2E);
    color: #C8A54E;
    padding: 12px 14px;
    border: none;
    border-left: 1px solid #1E2440;
    border-bottom: 2px solid #2A3150;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.02em;
    text-align: right;
}

QHeaderView::section:first {
    border-top-right-radius: 12px;
}

QHeaderView::section:last {
    border-top-left-radius: 12px;
    border-left: none;
}

QHeaderView::section:hover {
    background-color: #2A3150;
    color: #E8C96A;
}

/* ─── TABS ─────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #2A3150;
    border-radius: 12px;
    background-color: transparent;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #515874;
    border: 1px solid transparent;
    padding: 10px 22px;
    margin-left: 2px;
    border-top-right-radius: 12px;
    border-top-left-radius: 12px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.01em;
}

QTabBar::tab:hover {
    color: #F0F2F5;
    background-color: rgba(200,165,78,0.05);
}

QTabBar::tab:selected {
    color: #C8A54E;
    border: 1px solid #2A3150;
    border-bottom: 2px solid #C8A54E;
    background-color: #181D2E;
}

/* ─── MENU BAR ─────────────────────────────────────────── */
QMenuBar {
    background-color: #111520;
    color: #F0F2F5;
    border-bottom: 1px solid #1E2440;
    font-size: 13px;
    padding: 2px;
}

QMenuBar::item {
    padding: 6px 14px;
    border-radius: 8px;
    background: transparent;
    color: #8B92A8;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: rgba(200,165,78,0.12);
    color: #C8A54E;
}

QMenu {
    background-color: #2A3150;
    border: 1px solid #3A4468;
    border-radius: 12px;
    padding: 6px;
    color: #F0F2F5;
}

QMenu::item {
    padding: 10px 24px;
    border-radius: 8px;
    color: #8B92A8;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: rgba(200,165,78,0.12);
    color: #C8A54E;
}

QMenu::separator {
    height: 1px;
    background-color: #3A4468;
    margin: 4px 10px;
}

/* ─── TOOLBAR ──────────────────────────────────────────── */
QToolBar {
    background-color: #111520;
    border-bottom: 1px solid #1E2440;
    spacing: 6px;
    padding: 4px 8px;
}

QToolBar::separator {
    background-color: #2A3150;
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: #8B92A8;
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
}

QToolButton:hover {
    background-color: rgba(200,165,78,0.10);
    color: #C8A54E;
}

QToolButton:pressed {
    background-color: rgba(200,165,78,0.18);
}

/* ─── STATUS BAR ───────────────────────────────────────── */
QStatusBar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0C0E16,stop:1 #06070B);
    color: #515874;
    border-top: 1px solid #1E2440;
    font-size: 11px;
    padding: 2px 8px;
}

QStatusBar::item {
    border: none;
}

/* ─── SCROLLBARS (6px thin, GOLD hover) ────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border-radius: 3px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #2A3150;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #C8A54E;
}

QScrollBar::handle:vertical:pressed {
    background: #A88A3E;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border-radius: 3px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #2A3150;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #C8A54E;
}

QScrollBar::handle:horizontal:pressed {
    background: #A88A3E;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ─── PROGRESS BAR ─────────────────────────────────────── */
QProgressBar {
    background-color: #202640;
    border: none;
    border-radius: 8px;
    color: #F0F2F5;
    text-align: center;
    font-weight: 600;
    font-size: 11px;
    min-height: 8px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #A88A3E,stop:1 #C8A54E,stop:0.95 #E8C96A);
    border-radius: 8px;
}

QProgressBar[class="success"]::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #14B8A6,stop:1 #2DD4BF,stop:0.95 #5EEADB);
}

QProgressBar[class="warning"]::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #D97706,stop:1 #F59E0B,stop:0.95 #FBBF24);
}

QProgressBar[class="danger"]::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #DC4444,stop:1 #EF6B6B,stop:0.95 #F59B9B);
}

QProgressBar[class="info"]::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #38BDF8,stop:1 #7DD3FC);
}

/* ─── CHECKBOX & RADIO ─────────────────────────────────── */
QCheckBox,
QRadioButton {
    color: #8B92A8;
    spacing: 10px;
    font-size: 13px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #3A4468;
    border-radius: 5px;
    background-color: #202640;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #C8A54E;
}

QCheckBox::indicator:checked {
    background-color: #C8A54E;
    border-color: #C8A54E;
}

QRadioButton::indicator:checked {
    background-color: #C8A54E;
    border-color: #C8A54E;
}

/* ─── SPLITTER ─────────────────────────────────────────── */
QSplitter::handle {
    background-color: #202640;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #C8A54E;
}

/* ─── FRAME & SEPARATOR ────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #2A3150;
}

/* ─── TOOLTIP ──────────────────────────────────────────── */
QToolTip {
    background-color: #2A3150;
    color: #F0F2F5;
    border: 1px solid #3A4468;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 12px;
}

/* ─── SLIDER ───────────────────────────────────────────── */
QSlider::groove:horizontal {
    background: #202640;
    height: 6px;
    border-radius: 3px;
    border: none;
}

QSlider::handle:horizontal {
    background: #C8A54E;
    border: 2px solid #E8C96A;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #E8C96A;
    border-color: #FBBF24;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #A88A3E,stop:1 #C8A54E);
    border-radius: 3px;
}

/* ─── LIST WIDGET ──────────────────────────────────────── */
QListWidget {
    background-color: #111520;
    color: #F0F2F5;
    border: 1px solid #2A3150;
    border-radius: 12px;
    outline: none;
    font-size: 13px;
}

QListWidget::item {
    padding: 10px 14px;
    border-bottom: 1px solid #1E2440;
    color: #8B92A8;
}

QListWidget::item:hover {
    background-color: rgba(200,165,78,0.06);
    color: #F0F2F5;
}

QListWidget::item:selected {
    background-color: rgba(200,165,78,0.12);
    color: #C8A54E;
    border-right: 3px solid #C8A54E;
}

/* ─── TREE WIDGET ──────────────────────────────────────── */
QTreeWidget {
    background-color: #111520;
    color: #F0F2F5;
    border: 1px solid #2A3150;
    border-radius: 12px;
    outline: none;
    font-size: 13px;
    alternate-background-color: #0C0E16;
}

QTreeWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #1E2440;
    color: #8B92A8;
}

QTreeWidget::item:hover {
    background-color: rgba(200,165,78,0.06);
    color: #F0F2F5;
}

QTreeWidget::item:selected {
    background-color: rgba(200,165,78,0.12);
    color: #C8A54E;
}

QTreeWidget::item:expanded {
    color: #C8A54E;
}

/* ─── TEXT BROWSER ─────────────────────────────────────── */
QTextBrowser {
    background-color: #111520;
    color: #8B92A8;
    border: 1px solid #2A3150;
    border-radius: 12px;
    padding: 14px;
    font-size: 13px;
    selection-background-color: rgba(200,165,78,0.25);
}

/* ─── DOCK WIDGET ──────────────────────────────────────── */
QDockWidget {
    color: #F0F2F5;
    font-weight: 700;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #181D2E;
    padding: 10px;
    border-bottom: 1px solid #2A3150;
    border-radius: 12px 12px 0 0;
}

/* ─── CALENDAR ─────────────────────────────────────────── */
QCalendarWidget {
    background-color: #111520;
    color: #F0F2F5;
    border: 1px solid #2A3150;
    border-radius: 12px;
}

QCalendarWidget QToolButton {
    color: #C8A54E;
    background-color: transparent;
    font-weight: 700;
}

QCalendarWidget QAbstractItemView {
    background-color: #111520;
    color: #F0F2F5;
    selection-background-color: rgba(200,165,78,0.25);
    selection-color: #C8A54E;
}

/* ─── KPI CARDS (Dashboard) ────────────────────────────── */
#kpiCard {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #202640,stop:1 #181D2E);
    border: 1px solid #2A3150;
    border-radius: 16px;
}

#kpiCard:hover {
    border-color: #3A4468;
    background-color: #202640;
}

/* ─── SIZE GRIP ────────────────────────────────────────── */
QSizeGrip {
    width: 16px;
    height: 16px;
    image: none;
}
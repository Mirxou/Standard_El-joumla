/* ═══════════════════════════════════════════════════════════
   STANDARD EL-JOUMA — ROYAL DARK THEME v2.0
   Premium Arabic ERP Design System
   Color: Deep navy + Gold accent (#d4a853)

   Palette Reference:
     Void    : #08090d   — Deepest background
     Primary : #0f1117   — Sidebar, titlebar
     Surface : #161822   — Cards, panels, dialogs
     Raised  : #1e2030   — Inputs, raised elements
     Hover   : #252840   — Hover states
     Active  : #2a2d4a   — Active/pressed states
     Border  : #2a2d45   — Default borders
     Gold    : #d4a853   — Primary accent
     Text    : #f0f0f5   — Primary text
 ═══════════════════════════════════════════════════════════ */

/* ─── GLOBAL RESET ─────────────────────────────────────── */
* {
    outline: none;
    box-sizing: border-box;
}

QWidget {
    font-family: 'Cairo', 'Segoe UI', 'Roboto', sans-serif;
    font-size: 14px;
    color: #f0f0f5;
    background-color: transparent;
}

/* ─── MAIN CONTAINERS ──────────────────────────────────── */
QMainWindow {
    background-color: #08090d;
}

QWidget#centralWidget,
QStackedWidget {
    background-color: #08090d;
}

QFrame#mainFrame {
    background-color: #0f1117;
    border: 1px solid #2a2d45;
    border-radius: 14px;
}

QFrame#mainFrame:hover {
    border-color: #3d4166;
}

/* ─── DIALOG ───────────────────────────────────────────── */
QDialog {
    background-color: #161822;
    border: 1px solid #2a2d45;
    border-radius: 14px;
}

/* ─── MESSAGE BOX ──────────────────────────────────────── */
QMessageBox {
    background-color: #161822;
    color: #f0f0f5;
}

QMessageBox QLabel {
    color: #f0f0f5;
    font-size: 14px;
}

/* ─── SIDEBAR ──────────────────────────────────────────── */
QFrame#modernSidebar {
    background-color: #0f1117;
    border-right: 1px solid #1e2035;
}

QLabel#sidebarTitle {
    font-size: 16px;
    font-weight: 800;
    color: #d4a853;
    letter-spacing: 0.5px;
}

QLabel#sidebarSubtitle {
    font-size: 12px;
    color: #5d5f7a;
}

QPushButton#sidebarToggleBtn {
    background: transparent;
    border: none;
    color: #5d5f7a;
    font-size: 18px;
    padding: 4px;
    border-radius: 6px;
}

QPushButton#sidebarToggleBtn:hover {
    background-color: rgba(212, 168, 83, 0.12);
    color: #d4a853;
}

QPushButton#modernSidebarBtn {
    background-color: transparent;
    color: #9496b0;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    text-align: right;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#modernSidebarBtn:hover {
    background-color: rgba(212, 168, 83, 0.08);
    color: #f0f0f5;
    border-right: 3px solid #d4a853;
}

QPushButton#modernSidebarBtn:checked {
    background-color: rgba(212, 168, 83, 0.15);
    color: #d4a853;
    border-right: 3px solid #d4a853;
    font-weight: 700;
}

QPushButton#sidebarLogoutBtn {
    background-color: transparent;
    color: #e85454;
    border: 1px solid rgba(232, 84, 84, 0.4);
    border-radius: 10px;
    padding: 8px 14px;
    text-align: right;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#sidebarLogoutBtn:hover {
    background-color: rgba(232, 84, 84, 0.15);
    border-color: #e85454;
}

/* ─── SCROLL AREA ──────────────────────────────────────── */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ─── LABELS ───────────────────────────────────────────── */
QLabel {
    color: #f0f0f5;
    background-color: transparent;
}

/* ─── GROUP BOX ────────────────────────────────────────── */
QGroupBox {
    color: #d4a853;
    font-weight: 700;
    font-size: 14px;
    border: 1px solid #2a2d45;
    border-radius: 14px;
    margin-top: 24px;
    padding-top: 20px;
    background-color: rgba(22, 24, 34, 0.6);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 4px 12px;
    color: #d4a853;
    background-color: #161822;
    border: 1px solid #2a2d45;
    border-radius: 8px;
    right: 12px;
}

/* ─── BUTTONS ──────────────────────────────────────────── */
QPushButton {
    background-color: #1e2030;
    color: #f0f0f5;
    border: 1px solid #2a2d45;
    border-radius: 10px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 14px;
    min-height: 34px;
}

QPushButton:hover {
    background-color: #252840;
    border-color: #3d4166;
    color: #f0f0f5;
}

QPushButton:pressed {
    background-color: #2a2d4a;
    border-color: #d4a853;
}

QPushButton:disabled {
    background-color: #0f1117;
    color: #5d5f7a;
    border-color: #1e2035;
}

/* Primary Button — Gold fill */
QPushButton#primaryBtn,
QPushButton[class="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #d4a853, stop:1 #e8c878);
    color: #0f1117;
    border: none;
    font-weight: 700;
}

QPushButton#primaryBtn:hover,
QPushButton[class="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #e8c878, stop:1 #f0d888);
    color: #08090d;
}

QPushButton#primaryBtn:pressed,
QPushButton[class="primary"]:pressed {
    background: #b8923f;
    color: #08090d;
}

/* Flat Button */
QPushButton[flat="true"],
QPushButton[class="flat"] {
    background-color: transparent;
    color: #9496b0;
    border: 1px solid transparent;
    border-radius: 10px;
}

QPushButton[flat="true"]:hover,
QPushButton[class="flat"]:hover {
    background-color: rgba(212, 168, 83, 0.08);
    color: #f0f0f5;
    border-color: transparent;
}

/* Danger Button */
QPushButton[class="danger"] {
    background-color: rgba(232, 84, 84, 0.12);
    color: #e85454;
    border: 1px solid rgba(232, 84, 84, 0.3);
}

QPushButton[class="danger"]:hover {
    background-color: rgba(232, 84, 84, 0.2);
    border-color: #e85454;
}

/* Success Button */
QPushButton[class="success"] {
    background-color: rgba(45, 140, 111, 0.12);
    color: #2d8c6f;
    border: 1px solid rgba(45, 140, 111, 0.3);
}

QPushButton[class="success"]:hover {
    background-color: rgba(45, 140, 111, 0.2);
    border-color: #2d8c6f;
}

/* Close Button */
QPushButton#closeBtn,
QPushButton[class="close"] {
    background-color: transparent;
    color: #5d5f7a;
    border: none;
    border-radius: 6px;
    padding: 4px;
    min-height: 20px;
    min-width: 20px;
    font-size: 16px;
}

QPushButton#closeBtn:hover,
QPushButton[class="close"]:hover {
    background-color: rgba(232, 84, 84, 0.15);
    color: #e85454;
}

/* ─── INPUTS ───────────────────────────────────────────── */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #1e2030;
    color: #f0f0f5;
    border: 1px solid #2a2d45;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
    selection-background-color: #d4a853;
    selection-color: #0f1117;
    min-height: 34px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border: 1px solid #d4a853;
    background-color: #161822;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #3d4166;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #0f1117;
    color: #5d5f7a;
    border-color: #1e2035;
}

QLineEdit::placeholder,
QPlainTextEdit::placeholder {
    color: #5d5f7a;
}

/* ─── SPIN BOX BUTTONS ─────────────────────────────────── */
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: #252840;
    border: none;
    border-radius: 4px;
    width: 20px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: rgba(212, 168, 83, 0.2);
}

/* ─── DATE EDIT ARROWS ─────────────────────────────────── */
QDateEdit::drop-down,
QDateTimeEdit::drop-down {
    background-color: #252840;
    border: none;
    border-radius: 6px;
    width: 24px;
}

/* ─── COMBOBOX ─────────────────────────────────────────── */
QComboBox {
    background-color: #1e2030;
    color: #f0f0f5;
    border: 1px solid #2a2d45;
    border-radius: 10px;
    padding: 8px 32px 8px 12px;
    font-size: 14px;
    min-height: 34px;
}

QComboBox:hover {
    border-color: #3d4166;
}

QComboBox:focus {
    border-color: #d4a853;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
    subcontrol-position: left center;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #161822;
    border: 1px solid #2a2d45;
    border-radius: 10px;
    color: #f0f0f5;
    selection-background-color: rgba(212, 168, 83, 0.2);
    selection-color: #d4a853;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 10px 14px;
    min-height: 34px;
    border-radius: 6px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(212, 168, 83, 0.1);
}

/* ─── TABLES ───────────────────────────────────────────── */
QTableWidget,
QTableView {
    background-color: #0f1117;
    alternate-background-color: #13141f;
    color: #f0f0f5;
    gridline-color: #1e2035;
    border: 1px solid #2a2d45;
    border-radius: 10px;
    font-size: 13px;
    selection-background-color: rgba(212, 168, 83, 0.2);
    selection-color: #e8c878;
}

QTableWidget::item,
QTableView::item {
    padding: 10px 14px;
    color: #f0f0f5;
    border-bottom: 1px solid #1e2035;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: rgba(212, 168, 83, 0.2);
    color: #e8c878;
    border: none;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #1e2030;
}

QHeaderView {
    background-color: #0f1117;
}

QHeaderView::section {
    background-color: #161822;
    color: #d4a853;
    padding: 12px 14px;
    border: none;
    border-right: 1px solid #1e2035;
    border-bottom: 2px solid #2a2d45;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.3px;
}

QHeaderView::section:first {
    border-top-right-radius: 10px;
}

QHeaderView::section:last {
    border-top-left-radius: 10px;
    border-right: none;
}

QHeaderView::section:hover {
    background-color: #1e2030;
    color: #e8c878;
}

/* ─── TABS ─────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #2a2d45;
    border-radius: 10px;
    background-color: transparent;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #9496b0;
    border: 1px solid transparent;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-right-radius: 10px;
    border-top-left-radius: 10px;
    font-weight: 600;
    font-size: 14px;
}

QTabBar::tab:hover {
    color: #f0f0f5;
    background-color: rgba(212, 168, 83, 0.06);
}

QTabBar::tab:selected {
    color: #d4a853;
    border: 1px solid #2a2d45;
    border-bottom: 2px solid #d4a853;
    background-color: #161822;
}

/* ─── MENU BAR ─────────────────────────────────────────── */
QMenuBar {
    background-color: #0f1117;
    color: #f0f0f5;
    border-bottom: 1px solid #1e2035;
    font-size: 14px;
    padding: 2px;
}

QMenuBar::item {
    padding: 6px 14px;
    border-radius: 8px;
    background: transparent;
    color: #9496b0;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: rgba(212, 168, 83, 0.12);
    color: #d4a853;
}

QMenu {
    background-color: #161822;
    border: 1px solid #2a2d45;
    border-radius: 10px;
    padding: 6px;
    color: #f0f0f5;
}

QMenu::item {
    padding: 10px 24px;
    border-radius: 8px;
    color: #9496b0;
    font-size: 14px;
}

QMenu::item:selected {
    background-color: rgba(212, 168, 83, 0.15);
    color: #d4a853;
}

QMenu::separator {
    height: 1px;
    background-color: #2a2d45;
    margin: 4px 8px;
}

/* ─── TOOLBAR ──────────────────────────────────────────── */
QToolBar {
    background-color: #0f1117;
    border-bottom: 1px solid #1e2035;
    spacing: 6px;
    padding: 4px 8px;
}

QToolBar::separator {
    background-color: #2a2d45;
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: #9496b0;
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
}

QToolButton:hover {
    background-color: rgba(212, 168, 83, 0.1);
    color: #d4a853;
}

QToolButton:pressed {
    background-color: rgba(212, 168, 83, 0.2);
}

/* ─── STATUS BAR ───────────────────────────────────────── */
QStatusBar {
    background-color: #08090d;
    color: #5d5f7a;
    border-top: 1px solid #1e2035;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* ─── SCROLLBARS ───────────────────────────────────────── */
QScrollBar:vertical {
    background: #0f1117;
    width: 8px;
    border-radius: 4px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #2a2d45;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #d4a853;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #0f1117;
    height: 8px;
    border-radius: 4px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #2a2d45;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #d4a853;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ─── PROGRESS BAR ─────────────────────────────────────── */
QProgressBar {
    background-color: #1e2030;
    border: 1px solid #2a2d45;
    border-radius: 6px;
    color: #f0f0f5;
    text-align: center;
    font-weight: 600;
    font-size: 12px;
    min-height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #d4a853, stop:1 #e8c878);
    border-radius: 5px;
}

/* ─── CHECKBOX & RADIO ─────────────────────────────────── */
QCheckBox,
QRadioButton {
    color: #9496b0;
    spacing: 8px;
    font-size: 14px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #2a2d45;
    border-radius: 4px;
    background-color: #1e2030;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #d4a853;
}

QCheckBox::indicator:checked {
    background-color: #d4a853;
    border-color: #d4a853;
}

QRadioButton::indicator:checked {
    background-color: #d4a853;
    border-color: #d4a853;
}

/* ─── SPLITTER ─────────────────────────────────────────── */
QSplitter::handle {
    background-color: #2a2d45;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #d4a853;
}

/* ─── FRAME & SEPARATOR ────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #2a2d45;
}

/* ─── TOOLTIP ──────────────────────────────────────────── */
QToolTip {
    background-color: #161822;
    color: #f0f0f5;
    border: 1px solid #d4a853;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ─── SLIDER ───────────────────────────────────────────── */
QSlider::groove:horizontal {
    background: #1e2030;
    height: 6px;
    border-radius: 3px;
    border: 1px solid #2a2d45;
}

QSlider::handle:horizontal {
    background: #d4a853;
    border: 2px solid #d4a853;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #e8c878;
    border-color: #e8c878;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #d4a853, stop:1 #e8c878);
    border-radius: 3px;
}

/* ─── LIST WIDGET ──────────────────────────────────────── */
QListWidget {
    background-color: #0f1117;
    color: #f0f0f5;
    border: 1px solid #2a2d45;
    border-radius: 10px;
    outline: none;
    font-size: 14px;
}

QListWidget::item {
    padding: 10px 14px;
    border-bottom: 1px solid #1e2035;
    color: #9496b0;
}

QListWidget::item:hover {
    background-color: rgba(212, 168, 83, 0.06);
    color: #f0f0f5;
}

QListWidget::item:selected {
    background-color: rgba(212, 168, 83, 0.15);
    color: #d4a853;
    border-right: 3px solid #d4a853;
}

/* ─── TREE WIDGET ──────────────────────────────────────── */
QTreeWidget {
    background-color: #0f1117;
    color: #f0f0f5;
    border: 1px solid #2a2d45;
    border-radius: 10px;
    outline: none;
    font-size: 14px;
    alternate-background-color: #13141f;
}

QTreeWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #1e2035;
    color: #9496b0;
}

QTreeWidget::item:hover {
    background-color: rgba(212, 168, 83, 0.06);
    color: #f0f0f5;
}

QTreeWidget::item:selected {
    background-color: rgba(212, 168, 83, 0.15);
    color: #d4a853;
}

QTreeWidget::item:expanded {
    color: #d4a853;
}

/* ─── TEXT BROWSER ─────────────────────────────────────── */
QTextBrowser {
    background-color: #0f1117;
    color: #9496b0;
    border: 1px solid #2a2d45;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
    selection-background-color: rgba(212, 168, 83, 0.25);
}

/* ─── DOCK WIDGET ──────────────────────────────────────── */
QDockWidget {
    color: #f0f0f5;
    font-weight: 700;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #161822;
    padding: 10px;
    border-bottom: 1px solid #2a2d45;
    border-radius: 10px 10px 0 0;
}

/* ─── CALENDAR ─────────────────────────────────────────── */
QCalendarWidget {
    background-color: #0f1117;
    color: #f0f0f5;
    border: 1px solid #2a2d45;
    border-radius: 10px;
}

QCalendarWidget QToolButton {
    color: #d4a853;
    background-color: transparent;
    font-weight: 700;
}

QCalendarWidget QAbstractItemView {
    background-color: #0f1117;
    color: #f0f0f5;
    selection-background-color: rgba(212, 168, 83, 0.25);
    selection-color: #d4a853;
}

/* ─── KPI CARDS (Dashboard) ────────────────────────────── */
#kpiCard {
    background-color: #161822;
    border: 1px solid #2a2d45;
    border-radius: 14px;
}

#kpiCard:hover {
    border-color: #3d4166;
    background-color: #1e2030;
}

/* ─── SIZE GRIP ────────────────────────────────────────── */
QSizeGrip {
    width: 16px;
    height: 16px;
    image: none;
}

/* ─── DATE TIME EDIT (explicit) ────────────────────────── */
QDateTimeEdit {
    background-color: #1e2030;
    color: #f0f0f5;
    border: 1px solid #2a2d45;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
    selection-background-color: #d4a853;
    selection-color: #0f1117;
    min-height: 34px;
}

QDateTimeEdit:focus {
    border: 1px solid #d4a853;
    background-color: #161822;
}

QDateTimeEdit:hover {
    border-color: #3d4166;
}
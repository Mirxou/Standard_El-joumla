/* 
   THEME: GLOBAL PRO - SYSTEM 2.0 (DARK GLASS)
   Focus: Responsive, Collapsible, Interactive.
*/

/* --- GLOBAL COLORS --- */
QWidget {
    font-family: 'Segoe UI', 'Roboto', 'Cairo', sans-serif;
    color: #f8fafc;
}

/* --- MAIN WINDOW --- */
QMainWindow, #centralWidget, #mainFrame {
    background-color: #0f172a; /* Void Dark */
}

/* --- MODERN SIDEBAR CONTAINER --- */
#modernSidebar {
    background-color: #020617; /* Deepest Navy */
    border-right: 1px solid #1e293b;
    /* Smooth Transition for width changes handles by QAnimation, 
       but we can add generic transition for colors */
}

/* --- SIDEBAR HEADER --- */
#sidebarTitle {
    color: #38bdf8; /* Neon Blue */
    font-weight: 800;
    font-size: 18px;
    padding: 10px;
    letter-spacing: 0.5px;
}

/* --- TOGGLE BUTTON (Hamburger) --- */
#sidebarToggleBtn {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    font-size: 20px;
    padding: 5px;
    margin: 5px;
    border-radius: 4px;
}
#sidebarToggleBtn:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
}

/* --- NAVIGATION BUTTONS (System 2.0) --- */
QPushButton#modernSidebarBtn {
    background-color: transparent;
    color: #94a3b8; /* Muted Text */
    border: none;
    padding: 12px 10px; /* Reduced padding for cleaner look */
    text-align: left;
    font-size: 14px;
    font-weight: 600;
    margin: 2px 8px;
    border-radius: 8px;
}

QPushButton#modernSidebarBtn:hover {
    background-color: rgba(56, 189, 248, 0.1); /* Subtle Blue Tint */
    color: #e2e8f0;
}

QPushButton#modernSidebarBtn:checked {
    background-color: rgba(56, 189, 248, 0.2); /* Glassy Active State */
    color: #38bdf8; /* Neon Active Text */
    border-left: 3px solid #38bdf8; /* Accent Indicatior */
    text-shadow: 0 0 8px rgba(56, 189, 248, 0.6);
}

/* --- SPECIAL BUTTONS --- */
QPushButton#sidebarLogoutBtn {
    color: #ef4444; /* Red Text */
}
QPushButton#sidebarLogoutBtn:hover {
    background-color: rgba(239, 68, 68, 0.1);
    color: #f87171;
}

/* --- CONTENT AREA (Stacked Widget Pages) --- */
QStackedWidget {
    background-color: #0f172a;
}

/* --- PRESERVE EXISTING CARD STYLES --- */
QFrame#card, QGroupBox, QWidget#whitePanel {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
}

QGroupBox#kpiCard {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
}
QGroupBox#kpiCard:hover {
    border: 1px solid #38bdf8;
    background-color: #252f45;
}

/* --- TABLES --- */
QTableWidget, QTableView {
    background-color: #0f172a;
    gridline-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    color: #e2e8f0;
    selection-background-color: rgba(56, 189, 248, 0.2);
    selection-color: #ffffff;
    outline: none;
}
QHeaderView::section {
    background-color: #1e293b;
    color: #94a3b8;
    padding: 12px;
    border-bottom: 2px solid #334155;
    font-weight: 700;
    text-transform: uppercase;
}
QTableWidget::item {
    border-bottom: 1px solid #1e293b;
}

/* --- INPUTS --- */
QLineEdit, QComboBox, QSpinBox, QTextEdit {
    background-color: #020617;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 10px;
    color: #ffffff;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #38bdf8;
}

/* --- BUTTONS --- */
QPushButton#primaryBtn, QPushButton[class="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0ea5e9, stop:1 #2563eb);
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-weight: 700;
}
QPushButton#primaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #38bdf8, stop:1 #3b82f6);
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    border: none;
    background: #0f172a;
    width: 8px;
}
QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}

/* --- MENUS --- */
QMenu {
    background-color: #1e293b;
    border: 1px solid #334155;
    padding: 5px;
}
QMenu::item {
    color: #e2e8f0;
    padding: 8px 20px;
}
QMenu::item:selected {
    background-color: #38bdf8;
    color: #0f172a;
}

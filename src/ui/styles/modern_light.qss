/* 
   THEME: COMFORT SLATE (HIGH CONTRAST & CALM)
   Focus: Eye comfort, maximum readability, solid clean lines.
   Palette:
     - Background: #f1f5f9 (Soft Blue-Grey)
     - Sidebar: #1e293b (Dark Slate - Anchor)
     - Content Cards: #ffffff (Pure White)
     - Text: #0f172a (Deep Black-Blue)
     - Accent: #0d9488 (Teal - Calming & Modern)
*/

/* --- GLOBAL RESET --- */
QWidget {
    font-family: 'Segoe UI', 'Roboto', 'Cairo', sans-serif;
    font-size: 14px;
    color: #0f172a; /* Deepest Slate - High Contrast */
}

/* --- MAIN LAYOUT --- */
QMainWindow, #centralWidget, QWidget#mainFrame {
    background-color: #f1f5f9; /* Solid soft background, NO gradients */
    border: none; /* Clean edges */
    border-radius: 0px;
}

/* --- SIDEBAR (Dark Anchor) --- */
#sidebar {
    background-color: #1e293b; /* Dark Slate */
    border-right: 1px solid #334155;
    min-width: 250px;
}

#sidebar QLabel {
    color: #f8fafc; /* White text on dark sidebar */
    font-weight: 700;
    font-size: 16px;
    padding: 20px;
    background: transparent;
}

/* Sidebar Buttons */
#sidebarBtn {
    background-color: transparent;
    color: #cbd5e1; /* Light Grey */
    border: none;
    padding: 12px 20px;
    text-align: left;
    font-size: 14px;
    border-radius: 6px;
    margin: 4px 12px;
}

#sidebarBtn:hover {
    background-color: #334155; /* Lighter Slate */
    color: #ffffff;
    border-left: 4px solid #0d9488; /* Teal Accent */
}

#sidebarBtn:checked {
    background-color: #0d9488; /* Teal Filled */
    color: #ffffff;
    font-weight: bold;
    border-left: none;
}

/* --- CARDS & PANELS (SOLID WHITE) --- */
/* Replacing transparency with solid high-contrast white */
QFrame, QGroupBox#kpiCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0; /* Subtle border */
    border-radius: 10px;
}

/* Add shadow for depth without blur */
QGroupBox#kpiCard {
    border-bottom: 3px solid #e2e8f0;
}

/* --- CHARTS --- */
QChartView {
    background: transparent;
}

/* --- TABLES (CLEAN READABILITY) --- */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #e2e8f0;
    selection-background-color: #ccfbf1; /* Very Light Teal */
    selection-color: #115e59; /* Dark Teal Text */
    font-size: 13px;
}

QHeaderView::section {
    background-color: #f8fafc; /* Light Grey Header */
    color: #475569; /* Slate 600 */
    padding: 14px;
    border: none;
    border-bottom: 2px solid #cbd5e1;
    font-weight: 800;
}

QTableWidget::item {
    padding: 10px;
    border-bottom: 1px solid #f1f5f9;
}

/* --- INPUTS (CLEAR BOUNDARIES) --- */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #94a3b8; /* Visible Border */
    border-radius: 6px;
    padding: 10px;
    color: #0f172a;
    min-height: 26px;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #0d9488; /* Teal Focus */
    background-color: #ffffff;
}

/* --- BUTTONS (MATTE) --- */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 10px 24px;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #f8fafc;
    border-color: #0d9488;
    color: #0d9488;
}

/* Primary Action - Solid Teal */
QPushButton#primaryBtn, QPushButton[class="primary"] {
    background-color: #0d9488;
    color: #ffffff;
    border: none;
}

QPushButton#primaryBtn:hover, QPushButton[class="primary"]:hover {
    background-color: #0f766e; /* Darker Teal */
}

/* Danger Button */
QPushButton#dangerBtn {
    background-color: #ef4444;
    color: white;
    border: none;
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    border: none;
    background: #f1f5f9;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

/* --- TOOLTIPS --- */
QToolTip {
    background-color: #1e293b;
    color: #ffffff;
    border: none;
    padding: 8px;
    font-size: 12px;
}

/* --- DIALOGS --- */
QDialog {
    background-color: #f1f5f9;
}

/* ═══════════════════════════════════════════════════════════
   OBSIDIAN LUXE v3.0 — Input Styles
   ═══════════════════════════════════════════════════════════ */

/* QLineEdit */
QLineEdit {
    background-color: #1c2033;
    border: 1px solid #282d48;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 13px;
    color: #e8eaf0;
    selection-background-color: rgba(201,149,107,0.35);
    selection-color: #ffffff;
    min-height: 38px;
}

QLineEdit:focus {
    border: 1px solid #c9956b;
    background-color: #141724;
}

QLineEdit:hover {
    border-color: #363d5e;
}

QLineEdit:disabled {
    background-color: #0e1018;
    color: #363a56;
    border-color: #1c2033;
}

QLineEdit::placeholder {
    color: #5d6184;
}

/* QComboBox */
QComboBox {
    background-color: #1c2033;
    border: 1px solid #282d48;
    border-radius: 10px;
    padding: 9px 34px 9px 14px;
    font-size: 13px;
    color: #e8eaf0;
    min-height: 38px;
}

QComboBox:hover {
    border-color: #363d5e;
}

QComboBox:focus {
    border: 1px solid #c9956b;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #5d6184;
    width: 0px;
    height: 0px;
    margin-left: 8px;
}

QComboBox QAbstractItemView {
    background-color: #141724;
    border: 1px solid #282d48;
    border-radius: 12px;
    color: #e8eaf0;
    selection-background-color: rgba(201,149,107,0.18);
    selection-color: #e0b896;
    padding: 4px;
}

QComboBox:disabled {
    background-color: #0e1018;
    color: #363a56;
    border-color: #1c2033;
}

/* QSpinBox & QDoubleSpinBox */
QSpinBox, QDoubleSpinBox {
    background-color: #1c2033;
    border: 1px solid #282d48;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 13px;
    color: #e8eaf0;
    min-height: 38px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #363d5e;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #c9956b;
    background-color: #141724;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    border: none;
    border-left: 1px solid #282d48;
    border-top-right-radius: 10px;
    background-color: #232841;
    width: 22px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: rgba(201,149,107,0.15);
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid #5d6184;
    width: 0px;
    height: 0px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    border: none;
    border-left: 1px solid #282d48;
    border-bottom-right-radius: 10px;
    background-color: #232841;
    width: 22px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: rgba(201,149,107,0.15);
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #5d6184;
    width: 0px;
    height: 0px;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #0e1018;
    color: #363a56;
    border-color: #1c2033;
}


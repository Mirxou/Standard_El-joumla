/* ═══════════════════════════════════════════════════════════
   OBSIDIAN LUXE v3.0 — Table Styles
   ═══════════════════════════════════════════════════════════ */

QTableView, QTableWidget {
    background-color: #0e1018;
    border: 1px solid #282d48;
    border-radius: 12px;
    gridline-color: #1c2033;
    selection-background-color: rgba(201,149,107,0.18);
    selection-color: #e0b896;
    padding: 4px;
    alternate-background-color: #121420;
    font-size: 12px;
    color: #e8eaf0;
}

QTableView::item, QTableWidget::item {
    padding: 10px 14px;
    border: none;
    border-bottom: 1px solid #1c2033;
    color: #e8eaf0;
}

QTableView::item:not(:last-child), QTableWidget::item:not(:last-child) {
    border-bottom: 1px solid #1c2033;
}

QTableView::item:first-child, QTableWidget::item:first-child {
    border-top: none;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: rgba(201,149,107,0.18);
    color: #e0b896;
    border-bottom: 1px solid rgba(201,149,107,0.3);
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: #1c2033;
}

QTableView::item:alternate, QTableWidget::item:alternate {
    background-color: #121420;
}

/* Header Styling */
QHeaderView {
    background-color: #0e1018;
}

QHeaderView::section {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #1c2033,stop:1 #141724);
    color: #c9956b;
    padding: 12px 14px;
    border: none;
    border-left: 1px solid #1c2033;
    border-bottom: 2px solid #282d48;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.02em;
    text-align: right;
}

QHeaderView::section:first {
    border-top-right-radius: 12px;
}

QHeaderView::section:last {
    border-top-left-radius: 12px;
    border-left: none;
}

QHeaderView::section:selected {
    background-color: #232841;
    color: #e0b896;
}

QHeaderView::section:hover {
    background-color: #232841;
    color: #e0b896;
}

QHeaderView::section:pressed {
    background-color: #2a3052;
}
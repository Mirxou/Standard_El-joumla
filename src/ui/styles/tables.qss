/* ============================================
   Table Styles - QTableView, QTableWidget
   أنماط الجداول
   ============================================ */

QTableView, QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e0e4e7;
    border-radius: 6px;
    gridline-color: transparent;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
    padding: 4px;
    alternate-background-color: #fafbfc;
}

QTableView::item, QTableWidget::item {
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #f1f3f5;
}

QTableView::item:not(:last-child), QTableWidget::item:not(:last-child) {
    border-bottom: 1px solid #f1f3f5;
}

QTableView::item:first-child, QTableWidget::item:first-child {
    border-top: none;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
    border-bottom: 1px solid #2563eb;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: #f8fafc;
}

QTableView::item:alternate, QTableWidget::item:alternate {
    background-color: #fafbfc;
}

/* Header Styling */
QHeaderView::section {
    background-color: #f8fafc;
    color: #1e293b;
    padding: 10px 12px;
    border: none;
    border-bottom: 2px solid #e2e8f0;
    font-weight: 600;
    font-size: 13px;
    text-align: right;
}

QHeaderView::section:selected {
    background-color: #e2e8f0;
    color: #0f172a;
}

QHeaderView::section:hover {
    background-color: #f1f5f9;
}

QHeaderView::section:pressed {
    background-color: #e2e8f0;
}


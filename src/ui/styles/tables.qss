/* ═══════════════════════════════════════════════════════════
   AURORA NOIR v4.0 — Table Styles
   ═══════════════════════════════════════════════════════════ */

QTableView, QTableWidget {
    background-color: #111520;
    border: 1px solid #2A3150;
    border-radius: 12px;
    gridline-color: #1E2440;
    selection-background-color: rgba(200,165,78,0.18);
    selection-color: #E8C96A;
    padding: 4px;
    alternate-background-color: #0C0E16;
    font-size: 12px;
    color: #F0F2F5;
}

QTableView::item, QTableWidget::item {
    padding: 10px 14px;
    border: none;
    border-bottom: 1px solid #1E2440;
    color: #F0F2F5;
}

QTableView::item:not(:last-child), QTableWidget::item:not(:last-child) {
    border-bottom: 1px solid #1E2440;
}

QTableView::item:first-child, QTableWidget::item:first-child {
    border-top: none;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: rgba(200,165,78,0.18);
    color: #E8C96A;
    border-bottom: 1px solid rgba(200,165,78,0.3);
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: #1E2440;
}

QTableView::item:alternate, QTableWidget::item:alternate {
    background-color: #0C0E16;
}

/* Header Styling */
QHeaderView {
    background-color: #111520;
}

QHeaderView::section {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #202640,stop:1 #181D2E);
    color: #C8A54E;
    padding: 12px 14px;
    border: none;
    border-left: 1px solid #1E2440;
    border-bottom: 2px solid #2A3150;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.02em;
    text-align: right;
}

QHeaderView::section:first {
    border-top-right-radius: 12px;
}

QHeaderView::section:last {
    border-top-left-radius: 12px;
    border-left: none;
}

QHeaderView::section:selected {
    background-color: #2A3150;
    color: #E8C96A;
}

QHeaderView::section:hover {
    background-color: #2A3150;
    color: #E8C96A;
}

QHeaderView::section:pressed {
    background-color: #323C62;
}
/* src/ui/styles/vision_2030.qss */
/* تحسينات بصرية عالمية - Vision 2030 */

/* Global Settings */
QMainWindow, QDialog {
    background-color: #f3f4f6; /* لون خلفية مريح للعين (Light Gray) */
    font-family: "Segoe UI", "Cairo", sans-serif;
}

QWidget {
    font-family: "Segoe UI", "Cairo", sans-serif;
    color: #1f2937; /* Dark Gray Text */
}

/* البطاقات (Cards) لعرض المعلومات */
QWidget#ContentContainer, QFrame#Card {
    background-color: #ffffff;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
}

/* الأزرار الانسيابية مع تدرج لوني */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3b82f6, stop:1 #2563eb);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #1d4ed8);
    margin-top: -2px; /* حركة بسيطة عند التحويم */
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1d4ed8, stop:1 #1e40af);
    margin-top: 0px;
}

QPushButton:disabled {
    background: #d1d5db;
    color: #9ca3af;
}

/* Secondary Button */
QPushButton.secondary {
    background: transparent;
    border: 2px solid #3b82f6;
    color: #3b82f6;
}

QPushButton.secondary:hover {
    background: #eff6ff;
}

/* حقول الإدخال المريحة */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    padding: 10px;
    background-color: #f9fafb;
    selection-background-color: #3b82f6;
    font-size: 14px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #3b82f6;
    background-color: #ffffff;
}

/* Tables */
QTableWidget, QTableView {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    gridline-color: #f3f4f6;
    selection-background-color: #eff6ff;
    selection-color: #1e3a8a;
    outline: none;
}

QHeaderView::section {
    background-color: #f9fafb;
    color: #4b5563;
    padding: 12px;
    border: none;
    border-bottom: 2px solid #e5e7eb;
    font-weight: bold;
    font-size: 13px;
}

QTableWidget::item {
    padding: 8px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #f3f4f6;
    width: 10px;
    margin: 0px; 
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #d1d5db;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Menu Bar */
QMenuBar {
    background-color: #ffffff;
    padding: 5px;
    border-bottom: 1px solid #e5e7eb;
}

QMenuBar::item {
    padding: 8px 16px;
    background: transparent;
    border-radius: 6px;
    color: #374151;
}

QMenuBar::item:selected {
    background-color: #eff6ff;
    color: #2563eb;
}

/* Menu */
QMenu {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 5px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 8px;
    color: #374151;
}

QMenu::item:selected {
    background-color: #eff6ff;
    color: #2563eb;
}

/* ToolTip */
QToolTip {
    border: 1px solid #e5e7eb;
    background-color: #ffffff;
    color: #1f2937;
    padding: 5px;
    opacity: 230;
}

/* Tab Widget */
QTabWidget::pane { 
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #ffffff;
}

QTabBar::tab {
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-bottom-color: #e5e7eb; /* same as pane border */
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    min-width: 8ex;
    padding: 10px 20px;
    color: #6b7280;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: #ffffff;
    color: #2563eb;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: #e5e7eb;
}

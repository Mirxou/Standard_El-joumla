/* ═══════════════════════════════════════════════════════════
   AURORA NOIR v4.0 — Button Styles
   ═══════════════════════════════════════════════════════════ */

QPushButton {
    background-color: #202640;
    color: #F0F2F5;
    border: 1px solid #2A3150;
    border-radius: 10px;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 13px;
    min-height: 40px;
}

QPushButton:hover {
    background-color: #323C62;
    border-color: #3A4468;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #3C4875;
    border-color: #C8A54E;
}

QPushButton:disabled {
    background-color: #111520;
    color: #2E3550;
    border-color: #1E2440;
}

/* Primary — GOLD gradient */
QPushButton[class="primary"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #C8A54E,stop:1 #E8C96A);
    color: #111520;
    border: none;
    font-weight: 700;
}

QPushButton[class="primary"]:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #E8C96A,stop:1 #F0F2F5);
}

QPushButton[class="primary"]:pressed {
    background: #A88A3E;
    color: #111520;
}

QPushButton[class="primary"]:disabled {
    background-color: #202640;
    color: #515874;
}

/* Danger — CORAL */
QPushButton[class="danger"] {
    background-color: rgba(239,107,107,0.10);
    color: #EF6B6B;
    border: 1px solid rgba(239,107,107,0.25);
}

QPushButton[class="danger"]:hover {
    background-color: rgba(239,107,107,0.18);
    border-color: #EF6B6B;
}

QPushButton[class="danger"]:pressed {
    background-color: rgba(239,107,107,0.25);
}

/* Success — TEAL */
QPushButton[class="success"] {
    background-color: rgba(45,212,191,0.10);
    color: #2DD4BF;
    border: 1px solid rgba(45,212,191,0.25);
}

QPushButton[class="success"]:hover {
    background-color: rgba(45,212,191,0.18);
    border-color: #2DD4BF;
}

QPushButton[class="success"]:pressed {
    background-color: rgba(45,212,191,0.25);
}

/* Warning — AMBER */
QPushButton[class="warning"] {
    background-color: rgba(245,158,11,0.10);
    color: #F59E0B;
    border: 1px solid rgba(245,158,11,0.25);
}

QPushButton[class="warning"]:hover {
    background-color: rgba(245,158,11,0.18);
    border-color: #F59E0B;
}

QPushButton[class="warning"]:pressed {
    background-color: rgba(245,158,11,0.25);
}

/* Secondary — GOLD outline */
QPushButton[class="secondary"] {
    background-color: transparent;
    color: #C8A54E;
    border: 2px solid #C8A54E;
}

QPushButton[class="secondary"]:hover {
    background-color: rgba(200,165,78,0.12);
    color: #E8C96A;
}

QPushButton[class="secondary"]:pressed {
    background-color: rgba(200,165,78,0.18);
}

/* Amber — Gold fill */
QPushButton[class="amber"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #C8A54E,stop:1 #E8C96A);
    color: #111520;
    border: none;
    font-weight: 700;
}

QPushButton[class="amber"]:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #E8C96A,stop:1 #FBBF24);
}

/* Ghost — Most subtle */
QPushButton[class="ghost"] {
    background-color: transparent;
    color: #8B92A8;
    border: none;
    border-radius: 8px;
}

QPushButton[class="ghost"]:hover {
    background-color: rgba(200,165,78,0.06);
    color: #F0F2F5;
}

/* Flat */
QPushButton[class="flat"] {
    background-color: transparent;
    color: #8B92A8;
    border: 1px solid transparent;
    border-radius: 10px;
}

QPushButton[class="flat"]:hover {
    background-color: rgba(200,165,78,0.08);
    color: #F0F2F5;
}

/* Close */
QPushButton[class="close"] {
    background-color: transparent;
    color: #515874;
    border: none;
    border-radius: 8px;
    padding: 6px;
    min-height: 24px;
    min-width: 24px;
    font-size: 16px;
}

QPushButton[class="close"]:hover {
    background-color: rgba(239,107,107,0.12);
    color: #EF6B6B;
}
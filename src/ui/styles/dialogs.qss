/* ═══════════════════════════════════════════════════════════
   AURORA NOIR v4.0 — Dialog & Message Styles
   ═══════════════════════════════════════════════════════════ */

QDialog, QMessageBox {
    background-color: #181D2E;
    border: 1px solid #2A3150;
    border-radius: 16px;
}

QMessageBox QPushButton {
    min-width: 80px;
}

QGroupBox {
    border: 1px solid #2A3150;
    border-radius: 12px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: 700;
    font-size: 13px;
    color: #C8A54E;
    background-color: rgba(24,29,46,0.5);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 2px 14px;
    background-color: #181D2E;
    border: 1px solid #2A3150;
    border-radius: 8px;
    font-size: 12px;
}

QFrame {
    border: none;
    background-color: transparent;
}

QLabel {
    color: #F0F2F5;
    font-size: 13px;
    background-color: transparent;
}

QLabel[class="heading"] {
    font-weight: 700;
    font-size: 18px;
    color: #FFFFFF;
}

QLabel[class="subheading"] {
    font-weight: 500;
    font-size: 14px;
    color: #8B92A8;
}

QMenu {
    background-color: #2A3150;
    border: 1px solid #2A3150;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 10px 24px;
    border-radius: 8px;
    color: #8B92A8;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: rgba(200,165,78,0.12);
    color: #C8A54E;
}

QMenu::separator {
    height: 1px;
    background-color: #2A3150;
    margin: 4px 10px;
}

QListWidget {
    background-color: #111520;
    border: 1px solid #2A3150;
    border-radius: 12px;
    color: #F0F2F5;
}

QListWidget::item {
    padding: 10px 14px;
    border-bottom: 1px solid #1E2440;
    color: #8B92A8;
}

QListWidget::item:selected {
    background-color: rgba(200,165,78,0.12);
    color: #C8A54E;
    border-right: 3px solid #C8A54E;
}

QListWidget::item:hover {
    background-color: rgba(200,165,78,0.06);
    color: #F0F2F5;
}
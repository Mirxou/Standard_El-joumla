/* ═══════════════════════════════════════════════════════════
   OBSIDIAN LUXE v3.0 — General Base Styles
   ═══════════════════════════════════════════════════════════ */

* {
    font-family: 'Cairo', 'Noto Sans Arabic', 'Segoe UI', system-ui, sans-serif;
}

*:focus {
    outline: none;
}

QMainWindow, QWidget {
    background-color: #0a0b10;
    color: #e8eaf0;
}

QStatusBar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0a0b10,stop:1 #050507);
    color: #5d6184;
    border-top: 1px solid #1c2033;
    padding: 4px;
    font-size: 11px;
}

QToolTip {
    background-color: #232841;
    color: #e8eaf0;
    border: 1px solid #363d5e;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 12px;
}

QCheckBox {
    spacing: 10px;
    color: #9498b8;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #363d5e;
    border-radius: 5px;
    background-color: #1c2033;
}

QCheckBox::indicator:hover {
    border-color: #c9956b;
}

QCheckBox::indicator:checked {
    background-color: #c9956b;
    border-color: #c9956b;
}

QCheckBox::indicator:disabled {
    background-color: #0e1018;
    border-color: #1c2033;
}

QRadioButton {
    spacing: 10px;
    color: #9498b8;
    font-size: 13px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #363d5e;
    border-radius: 9px;
    background-color: #1c2033;
}

QRadioButton::indicator:hover {
    border-color: #c9956b;
}

QRadioButton::indicator:checked {
    border-color: #c9956b;
    background-color: #c9956b;
}

QRadioButton::indicator:disabled {
    background-color: #0e1018;
    border-color: #1c2033;
}
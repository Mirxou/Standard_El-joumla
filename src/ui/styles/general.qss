/* ═══════════════════════════════════════════════════════════
   AURORA NOIR v4.0 — General Base Styles
   ═══════════════════════════════════════════════════════════ */

* {
    font-family: 'Cairo', 'Noto Sans Arabic', 'Segoe UI', system-ui, sans-serif;
}

*:focus {
    outline: none;
}

QMainWindow, QWidget {
    background-color: #0C0E16;
    color: #F0F2F5;
}

QStatusBar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0C0E16,stop:1 #06070B);
    color: #515874;
    border-top: 1px solid #1E2440;
    padding: 4px;
    font-size: 11px;
}

QToolTip {
    background-color: #2A3150;
    color: #F0F2F5;
    border: 1px solid #3A4468;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 12px;
}

QCheckBox {
    spacing: 10px;
    color: #8B92A8;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #3A4468;
    border-radius: 5px;
    background-color: #202640;
}

QCheckBox::indicator:hover {
    border-color: #C8A54E;
}

QCheckBox::indicator:checked {
    background-color: #C8A54E;
    border-color: #C8A54E;
}

QCheckBox::indicator:disabled {
    background-color: #111520;
    border-color: #1E2440;
}

QRadioButton {
    spacing: 10px;
    color: #8B92A8;
    font-size: 13px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #3A4468;
    border-radius: 9px;
    background-color: #202640;
}

QRadioButton::indicator:hover {
    border-color: #C8A54E;
}

QRadioButton::indicator:checked {
    border-color: #C8A54E;
    background-color: #C8A54E;
}

QRadioButton::indicator:disabled {
    background-color: #111520;
    border-color: #1E2440;
}
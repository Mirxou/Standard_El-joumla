/* ═══════════════════════════════════════════════════════════
   OBSIDIAN LUXE v3.0 — Theme Variables Reference
   ═══════════════════════════════════════════════════════════

   Note: QSS doesn't support CSS variables natively.
   These are kept as reference documentation only.
   Actual values are in design_tokens.py and the QSS files.

   ── Background Depth Layers ──
   @void:      #050507
   @abyss:     #0a0b10
   @primary:   #0e1018
   @secondary: #141724
   @tertiary:  #1c2033
   @elevated:  #232841
   @hover:     #2a3052
   @active:    #313866

   ── Accent Colors ──
   @rose:      #c9956b  (Primary accent — Rose Gold)
   @amber:     #d4a853  (Financial accent — Amber Gold)
   @teal:      #3db89c  (Success — Teal)
   @blue:      #6b8cd4  (Info — Blue)

   ── Semantic ──
   @success:   #3db89c
   @warning:   #e0a040
   @danger:    #e05555
   @info:      #6b8cd4

   ── Text ──
   @text-bright:    #ffffff
   @text-primary:   #e8eaf0
   @text-secondary: #9498b8
   @text-muted:     #5d6184
   @text-ghost:     #363a56

   ── Borders ──
   @border-subtle:  #1c2033
   @border-default: #282d48
   @border-medium:  #363d5e
   @border-hover:   #4a5280
   @border-focus:   #c9956b

   ── Spacing (8px grid) ──
   @xs: 4px   @sm: 8px   @md: 12px  @lg: 16px
   @xl: 24px  @xxl: 32px @xxxl: 48px

   ── Radius ──
   @r-xs: 4px  @r-sm: 6px  @r-md: 8px
   @r-lg: 12px @r-xl: 16px @r-xxl: 20px
   ═══════════════════════════════════════════════════════════ */
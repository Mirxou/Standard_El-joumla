/* ═══════════════════════════════════════════════════════════
   AURORA NOIR v4.0 — Theme Variables Reference
   ═══════════════════════════════════════════════════════════

   Note: QSS doesn't support CSS variables natively.
   These are kept as reference documentation only.
   Actual values are in design_tokens.py and the QSS files.

   ── Background Depth Layers ──
   @void:      #06070B  (BG_VOID — deepest)
   @deep:      #0C0E16  (BG_DEEP)
   @primary:   #111520  (BG_PRIMARY — sidebar, main)
   @surface:   #181D2E  (BG_SURFACE — cards, panels, dialogs)
   @raised:    #202640  (BG_RAISED — inputs)
   @elevated:  #2A3150  (BG_ELEVATED — popovers, dropdowns, tooltips)
   @hover:     #323C62  (BG_HOVER)
   @active:    #3C4875  (BG_ACTIVE)

   ── Border Colors ──
   @border-void:    #111520  (BORDER_VOID)
   @border-subtle:  #1E2440  (BORDER_SUBTLE)
   @border-default: #2A3150  (BORDER_DEFAULT)
   @border-medium:  #3A4468  (BORDER_MEDIUM)
   @border-hover:   #4E5A88  (BORDER_HOVER)
   @border-focus:   #C8A54E  (BORDER_FOCUS — gold)

   ── Accent Colors ──
   @gold:       #C8A54E  (GOLD — primary accent)
   @gold-light: #E8C96A  (GOLD_LIGHT)
   @gold-dark:  #A88A3E  (GOLD_DARK)
   @teal:       #2DD4BF  (TEAL — success)
   @teal-light: #5EEADB  (TEAL_LIGHT)
   @teal-dark:  #14B8A6  (TEAL_DARK)
   @coral:      #EF6B6B  (CORAL — error)
   @coral-light:#F59B9B  (CORAL_LIGHT)
   @coral-dark: #DC4444  (CORAL_DARK)
   @amber:      #F59E0B  (AMBER — warning)
   @amber-light:#FBBF24  (AMBER_LIGHT)
   @amber-dark: #D97706  (AMBER_DARK)
   @sky:        #38BDF8  (SKY — info)
   @sky-light:  #7DD3FC  (SKY_LIGHT)

   ── Semantic Mapping ──
   @success:   #2DD4BF  (TEAL)
   @warning:   #F59E0B  (AMBER)
   @danger:    #EF6B6B  (CORAL)
   @info:      #38BDF8  (SKY)

   ── Text ──
   @text-bright:    #FFFFFF  (TEXT_BRIGHT)
   @text-primary:   #F0F2F5  (TEXT_PRIMARY)
   @text-secondary: #8B92A8  (TEXT_SECONDARY)
   @text-muted:     #515874  (TEXT_MUTED)
   @text-ghost:     #2E3550  (TEXT_GHOST)
   @text-inverse:   #111520  (TEXT_INVERSE)

   ── Subtle BG Colors (hover/focus) ──
   @gold-subtle:   rgba(200,165,78,0.10)
   @teal-subtle:   rgba(45,212,191,0.10)
   @coral-subtle:  rgba(239,107,107,0.10)
   @amber-subtle:  rgba(245,158,11,0.10)
   @sky-subtle:    rgba(56,189,248,0.10)

   ── Spacing (8px grid) ──
   @xs: 4px   @sm: 8px   @md: 12px  @lg: 16px
   @xl: 24px  @xxl: 32px @xxxl: 48px

   ── Radius ──
   @r-xs: 4px  @r-sm: 6px  @r-md: 8px
   @r-lg: 12px @r-xl: 16px @r-xxl: 20px
   ═══════════════════════════════════════════════════════════ */